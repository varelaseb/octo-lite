.octo-lite/drafts/
*.review/
.skillfile/cache/


__pycache__/
*.pyc
.claude/worktrees/

# skillfile materializes the upstream pins here. Only the tdd pin belongs in
# git; Stageshow the installer fetches at its pin and octo-lite never
# redistributes.
agents/skills/*
!agents/skills/tdd/
# skillfile bookkeeping, not skill content
agents/skills/tdd/.meta
# The recorder's dependencies, which the installer adds at the clone root
# (install.spec.html #install-recorder).
/node_modules/
