#!/usr/bin/env bash
# Close one Herdr tab or space and end everything it ran, or park one idle
# Claude agent.
#
# Closing a tab or space kills its panes, but a detached command child (setsid)
# survives, reparented. Every process started in a tab carries
# HERDR_TAB_ID=<tab> and HERDR_WORKSPACE_ID=<space> in its environ, so that tag,
# not the process tree, finds them. A tab id is <space>:<tab>; an id without a
# colon is a space. Run it from outside what it closes: the spawner owns teardown.
# Herdr ids repeat across sessions, so only processes of the caller's Herdr
# session count: those whose HERDR_SESSION equals the caller's, unset in both
# for the default session.
# Herdr leaves `herdr agent wait` on an agent running when the agent's tab
# closes; herdr-await bounds its every wait, so another caller's wait on an
# agent in what it closes ends as gone at its bound. The caller's own
# herdr-awaits on one, by name or pane id noted from Herdr, it ends whole before
# the close, waking no one: the caller closed it, so a gone would read as news
# of an agent spawned again under the same name.
#
# Prints one closed hand-off line ({at, kind, tab|space, close_rc, killed}),
# which the owner closing a consumed worker appends to the lane's hand-off log:
# every line it prints on either stream is one a hand-off log can hold.
#
# --park PANE reads the pane's Claude session (herdr-claude-session), closes its
# tab, or its space when that tab is the space's only one (a lane owner in its
# own space), and prints one parked hand-off line, even when the close fails;
# its closed line goes to stderr. The role is the record's, else the one a
# worker's spawn name <role>-<ticket> carries.
# An agent Herdr does not report idle or done (Herdr 0.9.0 reports a Claude
# agent waiting at its prompt as done), or one with no Claude session file
# (Codex, pi), is refused with nothing closed.
set -uo pipefail
here="$(dirname "$(readlink -f "$0")")"

usage() { echo "usage: herdr-close TAB|SPACE | --park PANE" >&2; exit 64; }
. "$here/herdr-claude-session" # ours ENVIRON [LINE]: the caller's session membership
line=""
if [[ "${1:-}" == --park ]]; then
  (($# == 2)) && [[ "$2" == *:* ]] || usage
  pane="$2"
  session="$("$here/herdr-claude-session" "$pane")" ||
    { echo "herdr-close: no Claude session in $pane; parking is Claude only" >&2; exit 65; }
  agent="$(herdr agent get "$pane")" || { printf '%s\n' "$agent" >&2; exit 1; }
  [[ "$(jq -r .result.agent.agent_status <<<"$agent")" == @(idle|done) ]] || { echo "herdr-close: $pane is not idle; not parked" >&2; exit 75; }
  name="$(jq -r .result.agent.name <<<"$agent")"
  space="$(jq -r '.result.agent.workspace_id // empty' <<<"$agent")"
  tabs="$(herdr workspace get "$space" 2>/dev/null | jq -r '.result.workspace.tab_count // empty')"
  [[ "$tabs" == 1 ]] && set -- "$space" || set -- "$(jq -r '.result.agent.tab_id // empty' <<<"$agent")"
  line="$(jq -c --arg at "$(date -u +%FT%TZ)" --arg pane "$pane" --arg name "$name" \
    '{at: $at, kind: "parked", pane: $pane, name: $name,
      role: (.agent // ($name | sub("-[a-z0-9]+-[0-9]+$"; ""))), cwd, session: .sessionId}' <<<"$session")"
fi

id="${1:-}"
[[ -n "$id" && "$id" != -* && $# -eq 1 ]] || usage

if [[ "$id" == *:* ]]; then kind=tab; tag=HERDR_TAB_ID; field=tab_id; cmd=(tab close)
else kind=space; tag=HERDR_WORKSPACE_ID; field=workspace_id; cmd=(workspace close); fi

# The names and pane ids of the agents in it, one per line.
agents="$(herdr agent list 2>/dev/null | jq -r --arg f "$field" --arg id "$id" \
  '.result.agents[]? | select(.[$f] == $id) | (.name // empty), .pane_id' 2>/dev/null)"
# True when process $1 is a herdr-await of the caller's pane on one of them:
# it leads its process group and carries HERDR_AWAIT_ON=<that name or pane id>.
awaits() {
  local vars v
  mapfile -d '' vars 2>/dev/null <"/proc/$1/environ" || return
  for v in "${vars[@]}"; do
    [[ "$v" == HERDR_AWAIT_ON=* ]] && grep -qxF -e "${v#*=}" <<<"$agents" &&
      ours "/proc/$1/environ" "HERDR_PANE_ID=${HERDR_PANE_ID:-}" && return
  done
  return 1
}

# End each process $1 picks; given -, all of its process group.
killed=0
sweep() {
  local env pid
  for env in /proc/[0-9]*/environ; do
    pid="${env#/proc/}"; pid="${pid%/environ}"
    "$1" "$pid" && kill -TERM -- "${2:-}$pid" 2>/dev/null && killed=$((killed + 1))
  done
}
tagged() { ours "/proc/$1/environ" "$tag=$id"; }

# Its own awaits end before the close, so none waits again on a closed agent.
sweep awaits -
rc=0
herdr "${cmd[@]}" "$id" >/dev/null 2>&1 || rc=$?
sweep tagged

closed="$(jq -nc --arg at "$(date -u +%FT%TZ)" --arg kind "$kind" --arg id "$id" --argjson rc "$rc" \
  --argjson killed "$killed" '{at: $at, kind: "closed", ($kind): $id, close_rc: $rc, killed: $killed}')"
if [[ -z "$line" ]]; then echo "$closed"
else echo "$closed" >&2; echo "$line"; fi
exit "$rc"
