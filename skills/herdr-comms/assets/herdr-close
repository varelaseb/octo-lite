#!/usr/bin/env bash
# Close one Herdr tab or space and end everything it ran, or park one idle
# Claude agent.
#
# Closing a tab or space kills its panes, but a detached command child (setsid)
# survives, reparented. Every process started in a tab carries
# HERDR_TAB_ID=<tab> and HERDR_WORKSPACE_ID=<space> in its environ, so that tag,
# not the process tree, finds them. A tab id is <space>:<tab>; an id without a
# colon is a space. Run it from outside what it closes: the spawner owns teardown.
#
# --park PANE reads the session of the Claude process in PANE from Claude's own
# ~/.claude/sessions/<pid>.json, closes its tab, or its space when that tab is
# the space's only one (a lane owner in its own space), and prints one parked
# hand-off line, even when the close fails. An agent Herdr does not report idle
# or done (Herdr 0.9.0 reports a Claude agent waiting at its prompt as done), or
# one with no Claude session file (Codex), is refused with nothing closed.
set -uo pipefail

usage() { echo "usage: herdr-close TAB|SPACE | --park PANE" >&2; exit 64; }
line=""
if [[ "${1:-}" == --park ]]; then
  (($# == 2)) && [[ "$2" == *:* ]] || usage
  pane="$2"; session=""
  for file in "$HOME"/.claude/sessions/[0-9]*.json; do
    pid="${file##*/}"; pid="${pid%.json}"
    tr '\0' '\n' 2>/dev/null </proc/"$pid"/environ | grep -qxF "HERDR_PANE_ID=$pane" && { session="$file"; break; }
  done
  [[ -n "$session" ]] || { echo "herdr-close: no Claude session in $pane; parking is Claude only" >&2; exit 65; }
  agent="$(herdr agent get "$pane")" || { printf '%s\n' "$agent" >&2; exit 1; }
  [[ "$(jq -r .result.agent.agent_status <<<"$agent")" == @(idle|done) ]] || { echo "herdr-close: $pane is not idle; not parked" >&2; exit 75; }
  name="$(jq -r .result.agent.name <<<"$agent")"
  space="$(jq -r '.result.agent.workspace_id // empty' <<<"$agent")"
  tabs="$(herdr workspace get "$space" 2>/dev/null | jq -r '.result.workspace.tab_count // empty')"
  [[ "$tabs" == 1 ]] && set -- "$space" || set -- "$(jq -r '.result.agent.tab_id // empty' <<<"$agent")"
  line="$(jq -c --arg at "$(date -u +%FT%TZ)" --arg pane "$pane" --arg name "$name" \
    '{at: $at, kind: "parked", pane: $pane, name: $name, role: .agent, cwd, session: .sessionId}' "$session")"
fi

id="${1:-}"
[[ -n "$id" && "$id" != -* && $# -eq 1 ]] || usage

if [[ "$id" == *:* ]]; then kind=tab; tag=HERDR_TAB_ID; cmd=(tab close)
else kind=space; tag=HERDR_WORKSPACE_ID; cmd=(workspace close); fi

rc=0
herdr "${cmd[@]}" "$id" >/dev/null 2>&1 || rc=$?

killed=0
for env in /proc/[0-9]*/environ; do
  pid="${env#/proc/}"; pid="${pid%/environ}"
  tr '\0' '\n' 2>/dev/null <"$env" | grep -qxF "$tag=$id" || continue
  kill -TERM "$pid" 2>/dev/null && killed=$((killed + 1))
done

report="$kind=$id ${kind}_close_rc=$rc killed=$killed"
if [[ -z "$line" ]]; then echo "$report"
else echo "$report" >&2; echo "$line"; fi
exit "$rc"
