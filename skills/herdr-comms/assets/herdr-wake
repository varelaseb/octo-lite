#!/usr/bin/env bash
# Spec Chat's `wake` provider over Herdr. install-octo-lite registers it in
# Spec Chat's providers/wake.toml; Spec Chat owns that format and names no
# pane tool. Exit codes are Spec Chat's wake protocol:
#   herdr-wake check OWNER                  0 owner pane resolves, 1 not
#   herdr-wake send OWNER ARTIFACT MESSAGE  0 sent, 75 deferred, other failed
# send keeps host-wake's states: a working owner defers; a prompt Herdr typed
# but did not see land (agent_prompt_stalled) counts as sent so the same batch
# is never retyped. A parked owner counts as present.
# Spec Chat bounds send, kills its process group at that bound, and counts it
# sent. send runs herdr-say, and the reader of its stderr, in a session of its
# own, so a send outliving the bound (a parked resume, a rate-limit wait) keeps
# delivering. Spec Chat no longer waits on it, so when it then ends deferred or
# failed, its reason goes once to the operator pane of the owner's session
# (operator.toml); within the bound it goes to Spec Chat, which retries.
# OWNER is a pane of the caller's Herdr session, or SESSION/PANE: a pane of
# Herdr session SESSION, so a review service of one session wakes an owner in
# another. Herdr selects the session by HERDR_SESSION unless HERDR_SOCKET_PATH
# pins one, so the socket is dropped.
# A launcher's search path (cron: /usr/bin:/bin) may lack ~/.local/bin, where
# Herdr installs; herdr-say and what it starts inherit this one.
# A failed check or send writes a one-line reason to stderr.
set -uo pipefail
export PATH="$PATH:$HOME/.local/bin"

usage() { echo "usage: herdr-wake check OWNER | send OWNER ARTIFACT MESSAGE" >&2; exit 64; }

# Print the owner's agent_status, or parked for one herdr-say would resume;
# fail with the reason on stderr.
status() {
  local out err f rc=0
  command -v herdr >/dev/null || { echo "herdr-wake: herdr not found on PATH $PATH" >&2; return 1; }
  f="$(mktemp)"
  out="$(timeout -k 1 5 herdr agent get "$1" 2>"$f")" || rc=$?
  err="$(<"$f")"; rm -f "$f"
  ((rc == 0)) && jq -er --arg p "$1" '.result.agent | select(.pane_id == $p)
    | .agent_status // "unknown"' <<<"$out" 2>/dev/null && return
  "$say" --parked "$1" >/dev/null 2>&1 && { echo parked; return; }
  if ((rc == 0)) || [[ "$(jq -r '.error.code?' <<<"$err" 2>/dev/null)" == agent_not_found ]]; then
    echo "herdr-wake: owner pane $1 not found in Herdr session ${HERDR_SESSION:-default}" >&2
  elif ((rc == 124)); then
    echo "herdr-wake: Herdr not answering: herdr agent get $1 timed out after 5s" >&2
  else
    echo "herdr-wake: herdr agent get $1: ${err//$'\n'/ }" >&2
  fi
  return 1
}

# send's own step, run as herdr-wake deliver in a session of its own: herdr-say
# to owner $1 for artifact $2 with message $3, ending with its exit. The send
# that started it gone (this one's parent changed) means Spec Chat's bound
# killed it.
deliver() {
  local err rc=0
  err="$("$say" --kind command --artifact "$2" "$1" "$3" 2>&1 >/dev/null)" || rc=$?
  ((rc == 0)) || grep -q '"code": *"agent_prompt_stalled"' <<<"$err" && return
  err="${err:-herdr-say exited $rc}"; err="${err//$'\n'/ }"
  if [[ "$(cut -d' ' -f4 /proc/$$/stat)" == "$PPID" ]]; then
    ((rc == 75)) || echo "herdr-wake: $err" >&2
  else
    "$say" "$(sed -n 's/^pane *= *"\(.*\)"$/\1/p' "$("$state")/operator.toml")" \
      "herdr-wake: $2 hand-off to owner $1, counted sent by Spec Chat, not processed: $err" >/dev/null 2>&1
  fi
  return "$rc"
}

here="$(dirname "$(readlink -f "$0")")"
say="$here/herdr-say" state="$here/../../../scripts/octo-lite-state"
if [[ "${2:-}" == */* ]]; then
  export HERDR_SESSION="${2%%/*}"; unset HERDR_SOCKET_PATH
  set -- "$1" "${2#*/}" "${@:3}"
fi
case "${1:-}" in
  check)
    (($# == 2)) || usage
    status "$2" >/dev/null ;;
  send)
    (($# == 4)) || usage
    s="$(status "$2")" || exit 1
    [[ "$s" == working ]] && exit 75
    setsid -w "$0" deliver "$2" "$3" "$4" </dev/null ;;
  deliver) deliver "${@:2}" ;;
  *) usage ;;
esac
