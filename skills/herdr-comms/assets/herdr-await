#!/usr/bin/env bash
# The one wait on a lane agent (spec #transport-await): roles never run
# `herdr agent wait` themselves.
#
#   herdr-await [--since SEQ] NAME [MESSAGE]
#
# Returns at once. Apart from its caller, it sends MESSAGE to NAME by herdr-say
# when given, then waits (`herdr agent wait NAME`) until NAME is idle, done, or
# blocked on interactive input, or gone: its agent exited, its tab closed, or
# Herdr finds no agent by that name. Then it sends the caller's pane
# ($HERDR_PANE_ID) one wake for that stop, naming NAME and the stop; a wake the
# caller refuses while blocked on interactive input (herdr-say exit 75) is sent
# again once it frees, until it lands:
#   herdr-await: NAME stop=STATE seq=N      stopped in STATE, Herdr's state_change_seq N
#   herdr-await: NAME stop=gone (REASON)    Herdr's error code, or the wait's exit
#   herdr-await: NAME stop=send-failed (herdr-say exit RC: ERROR)   no wait ran
# Given --since SEQ, the seq of the stop its caller last read, it ends only once
# NAME has changed state since that stop and stopped again, or is gone, so an
# agent that works and stops before the wait starts still ends it at once.
# Every Herdr wait it runs is bounded, and at the bound it waits again, given
# --since reading NAME's stop first: Herdr leaves a wait on an agent whose tab
# closed running, so a closed tab ends it as gone, and work and a stop between
# two waits ends it, within the bound. At the bound a caller pane Herdr no
# longer finds ends it, waking no one.
# A message wakes a Claude, Codex, or pi caller the same way, and a send that
# waits out a rate limit holds no caller in the foreground. The detached wait
# keeps the caller's environ, HERDR_TAB_ID included, so herdr-close of the
# caller's tab, parking included, ends it with the caller's other processes.
# It leads its own process group and carries HERDR_AWAIT_ON=NAME, so herdr-close
# of NAME's tab or space by the same caller ends all of it, waking no one.
set -uo pipefail
here="$(dirname "$(readlink -f "$0")")"
bound=60000 # ms, each Herdr wait's

usage() { echo "usage: herdr-await [--since SEQ] NAME [MESSAGE]" >&2; exit 64; }
argv=("$@") since=
if [[ "${1:-}" == --since ]]; then
  [[ "${2:-}" =~ ^[0-9]+$ ]] || usage
  since="$2"; shift 2
fi
(($# == 1 || $# == 2)) && [[ -n "$1" && "$1" != -* ]] || usage
caller="${HERDR_PANE_ID:-}"
[[ -n "$caller" ]] || { echo "herdr-await: no caller pane (HERDR_PANE_ID) to wake" >&2; exit 64; }

if [[ -z "${HERDR_AWAIT_ON:-}" ]]; then
  HERDR_AWAIT_ON="$1" setsid -f "$here/herdr-await" "${argv[@]}" </dev/null >/dev/null 2>&1
  exit
fi
unset HERDR_AWAIT_ON

name="$1"
# One Herdr wait, bounded: its result in $out, else its exit in $rc and Herdr's
# error code in $code, timeout at the bound, where a caller Herdr finds no agent
# for ends it all. Herdr's result goes to stdout, its error to stderr, either
# beside warnings.
code() { jq -Rr 'fromjson? | .error.code // empty' <<<"$1"; }
bounded() {
  out="$(herdr agent wait "$@" --timeout "$bound" 2>&1)" && return
  rc=$?; code="$(code "$out")"
  [[ "$code" != timeout || "$(code "$(herdr agent get "$caller" 2>&1)")" != agent_not_found ]] || exit
  return 1
}
# One wake per stop: a caller blocked on interactive input (herdr-say exit 75)
# gets it once it frees.
stop() {
  until "$here/herdr-say" "$caller" "herdr-await: $name stop=$1" >/dev/null 2>&1; (($? != 75)); do
    bounded "$caller" --until idle --until done --until working || [[ "$code" == timeout ]] || break
  done
  exit
}
if (($# == 2)); then
  err="$("$here/herdr-say" "$name" "$2" 2>&1 >/dev/null)" ||
    { rc=$?; stop "send-failed (herdr-say exit $rc: ${err//$'\n'/ })"; }
fi
# A wait on NAME, its seq in $seq; false at the bound; any other failure is gone.
await() {
  bounded "$name" "$@" || { [[ "$code" == timeout ]] || stop "gone (${code:-herdr agent wait exit $rc})"; return 1; }
  seq="$(jq -Rr 'fromjson? | .result.agent.state_change_seq // empty' <<<"$out")"
}
# Till NAME stops; given --since and still at that stop, its next work, then
# its stop, the stop read again at each bound.
until await && { [[ -z "$since" ]] || ((seq > since)); }; do
  [[ -z "$since" ]] || await --until working
done
stop "$(jq -Rr 'fromjson? | .result.agent // empty | "\(.agent_status) seq=\(.state_change_seq)"' <<<"$out")"
