#!/usr/bin/env bash
# The one wait on a lane agent (spec/domains/herdr-transport.spec.html#transport-await):
# roles never run `herdr agent wait` themselves.
#
#   herdr-await [--since SEQ] NAME [MESSAGE]
#
# It sends MESSAGE to NAME by herdr-say when given, then waits (`herdr agent
# wait NAME`) until NAME is idle, done, or blocked on interactive input, or
# gone: its agent exited, its tab closed, or Herdr finds no agent by that name.
# Its end is one line naming NAME and the stop:
#   herdr-await: NAME stop=STATE seq=N      stopped in STATE, Herdr's state_change_seq N
#   herdr-await: NAME stop=stalled (ERROR: TEXT)   its turn ended on an API error
#   herdr-await: NAME stop=gone (REASON)    Herdr's error code, or the wait's exit
#   herdr-await: NAME stop=send-failed (herdr-say exit RC: ERROR)   no wait ran
# Herdr reports a Claude turn an API error ended, a dropped connection as much
# as a rate limit, as idle or done: a stop whose last reply in the Claude
# session (herdr-claude-session) of NAME's pane is an API error is stalled.
# A caller whose pane ($HERDR_PANE_ID) holds a live Claude session
# (herdr-claude-session), which runs it as its own background task, gets it
# as the call's end: it waits in that task's foreground, prints the line on
# stdout, and exits 0, so the task's end is the caller's wake, never text typed
# into a prompt a human may be typing in. Any other caller, Codex or pi: it
# returns at once, waits apart from its caller, and sends the caller's pane the
# line as a message; a wake the caller refuses while blocked on
# interactive input (herdr-say exit 75) is sent again once it frees, until it
# lands. Either way a send that waits out a rate limit holds no caller in the
# foreground.
# Given --since SEQ, the seq of the stop its caller last read, it ends only once
# NAME has changed state since that stop and stopped again, or is gone, so an
# agent that works and stops before the wait starts still ends it at once.
# Every Herdr wait it runs is bounded, and at the bound it waits again, given
# --since reading NAME's stop first: Herdr leaves a wait on an agent whose tab
# closed running, so a closed tab ends it as gone, and work and a stop between
# two waits ends it, within the bound. At the bound a caller pane Herdr no
# longer finds ends it, waking no one. A Herdr wait its server is too loaded
# to answer (server_unavailable) is no stop: it waits again a second later.
# The wait keeps the caller's environ, HERDR_TAB_ID included, so herdr-close of
# the caller's tab, parking included, ends it with the caller's other
# processes. It leads its own process group and carries HERDR_AWAIT_ON=NAME, so
# herdr-close of NAME's tab or space by the same caller ends all of it, sending
# no message; a Claude caller's wait so ended prints, instead of a stop:
#   herdr-await: NAME closed by its caller
set -uo pipefail
here="$(dirname "$(readlink -f "$0")")"
bound=60000 # ms, each Herdr wait's

usage() { echo "usage: herdr-await [--since SEQ] NAME [MESSAGE]" >&2; exit 64; }
argv=("$@") since=
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    --notice) shift ;; # ignored, the pane decides: an owner started passing it still works
    --since) [[ "${2:-}" =~ ^[0-9]+$ ]] || usage; since="$2"; shift 2 ;;
    *) usage ;;
  esac
done
(($# == 1 || $# == 2)) && [[ -n "$1" ]] || usage
caller="${HERDR_PANE_ID:-}"
[[ -n "$caller" ]] || { echo "herdr-await: no caller pane (HERDR_PANE_ID) to wake" >&2; exit 64; }

# The caller's pane decides the form once, here, and the re-exec carries it as
# HERDR_AWAIT_NOTICE. The foreground form's setsid forks and stays when its
# caller leads its own group, so it carries no HERDR_AWAIT_ON, or herdr-close
# would end the caller's group.
if [[ -z "${HERDR_AWAIT_ON:-}" ]]; then
  "$here/herdr-claude-session" "$caller" >/dev/null 2>&1 &&
    exec setsid -w env HERDR_AWAIT_ON="$1" HERDR_AWAIT_NOTICE=1 "$here/herdr-await" "${argv[@]}"
  HERDR_AWAIT_ON="$1" setsid -f "$here/herdr-await" "${argv[@]}" </dev/null >/dev/null 2>&1
  exit
fi
notice="${HERDR_AWAIT_NOTICE:-}"
unset HERDR_AWAIT_ON HERDR_AWAIT_NOTICE

name="$1"
# herdr-close's TERM; detached, stdout is /dev/null.
trap 'echo "herdr-await: $name closed by its caller"; exit' TERM
# One Herdr wait, bounded: its result in $out, else its exit in $rc and Herdr's
# error code in $errcode, timeout at the bound, where a caller Herdr finds no
# agent for ends it all; server_unavailable waits again. Herdr's result goes to
# stdout, its error to stderr, either beside warnings.
code() { jq -Rr 'fromjson? | .error.code // empty' <<<"$1"; }
bounded() {
  until out="$(herdr agent wait "$@" --timeout "$bound" 2>&1)"; do
    rc=$?; errcode="$(code "$out")"
    [[ "$errcode" == server_unavailable ]] || {
      [[ "$errcode" != timeout || "$(code "$(herdr agent get "$caller" 2>&1)")" != agent_not_found ]] || exit
      return 1; }
    sleep 1
  done
}
# One wake per stop, its line on stdout for a Claude caller, else sent: a caller
# blocked on interactive input (herdr-say exit 75) gets it once it frees.
stop() {
  [[ -z "$notice" ]] || { echo "herdr-await: $name stop=$1"; exit; }
  until "$here/herdr-say" "$caller" "herdr-await: $name stop=$1" >/dev/null 2>&1; (($? != 75)); do
    bounded "$caller" --until idle --until done --until working || [[ "$errcode" == timeout ]] || break
  done
  exit
}
if (($# == 2)); then
  err="$("$here/herdr-say" "$name" "$2" 2>&1 >/dev/null)" ||
    { rc=$?; stop "send-failed (herdr-say exit $rc: ${err//$'\n'/ })"; }
fi
# A wait on NAME, its seq in $seq; false at the bound; any other failure is gone.
await() {
  bounded "$name" "$@" || { [[ "$errcode" == timeout ]] || stop "gone (${errcode:-herdr agent wait exit $rc})"; return 1; }
  seq="$(jq -Rr 'fromjson? | .result.agent.state_change_seq // empty' <<<"$out")"
}
# Till NAME stops; given --since and still at that stop, its next work, then
# its stop, the stop read again at each bound.
until await && { [[ -z "$since" ]] || ((seq > since)); }; do
  [[ -z "$since" ]] || await --until working
done
# The last reply in the transcript of pane $1's Claude session, an assistant
# record off any sidechain read from its end, when it is an API error: its
# error and text.
api_error() {
  local transcript
  transcript="$("$here/herdr-claude-session" "$1" 2>/dev/null | jq -r '.transcript // empty')"
  [[ -n "$transcript" ]] && tac "$transcript" 2>/dev/null | jq -rn '
    first(inputs | select(.type == "assistant" and .isSidechain == false))
    | select(.isApiErrorMessage == true) | "\(.error): \(.message.content[0].text)"'
}
error="$(api_error "$(jq -Rr 'fromjson? | .result.agent.pane_id // empty' <<<"$out")")"
[[ -z "$error" ]] || stop "stalled (${error//$'\n'/ })"
stop "$(jq -Rr 'fromjson? | .result.agent // empty | "\(.agent_status) seq=\(.state_change_seq)"' <<<"$out")"
