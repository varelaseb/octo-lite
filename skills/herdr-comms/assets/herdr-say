#!/usr/bin/env bash
# Send one message to a Herdr agent, and confirm it actually landed.
#
# This is a thin wrapper over a single native Herdr command:
#   herdr agent prompt TARGET TEXT --wait --until working --until idle
#
# Native Herdr already solves what this script used to solve by hand. It
# refuses a blocked agent outright (`agent_blocked`) rather than typing into an
# open dialog, so no modal guard is needed; and `--wait --until` returns only on
# an observed state change, so delivery is confirmed by Herdr rather than by an
# acknowledgement the agent sends about itself.
#
# A Claude agent whose turn dies at once on an API rate limit (credentials
# cooling down) has not processed the message, though Herdr saw it work. After
# each send the pane's Claude session (herdr-claude-session) decides: the
# message is processed unless its own reply, within a few seconds, is a
# rate-limit error. Its own reply is the first after the transcript record
# carrying it, a slash command's as Claude records it, its name and args: Herdr
# does not track turns, so for a target already working the state change and
# the reply after it are the running turn's, and a message enqueued behind that
# turn waits until taken in, however long that turn runs. One still not taken
# in once that turn has ended or Claude has exited never reached the agent.
# Otherwise the same message is sent again, waits doubling from a minute,
# capped, about two hours in all. The error names no time it clears.
# Codex and pi keep no Claude session: the state change alone confirms.
#
# Exit codes are the contract callers rely on, including
# `herdr-wake`, Spec Chat's wake provider:
#   0   delivered, and Herdr observed the agent change state; a Claude agent
#       also processed it
#   69  not processed: a Claude agent's turn died on an API rate limit at every
#       send; stderr names the target, the number of sends, the last API error;
#       every re-send is already spent, so the caller never sends it again
#   75  not delivered now because the target is blocked on interactive input;
#       the caller should retry once the target is free
#   >0  anything else, 1 for a message never taken in, stderr naming the target
#
# A target Herdr does not find may be parked: the latest parked line naming it,
# in any lane hand-off log of the caller's Herdr session (octo-lite-state),
# decides; another session's lanes repeat its ids. A live agent under the
# line's name gets the message; otherwise the agent is resumed first (an owner,
# the lane's name, in a new lane space; a worker in the caller's space, under
# the line's role, else the one its spawn name <role>-<ticket> carries), and its
# new pane= is printed. Every re-send does the same, so a target parked during
# a wait is resumed. A log line that is not one JSON object is skipped, its log
# and line number named on stderr.
# `herdr-say --parked TARGET` prints that line, or exits 1 when there is none.
set -euo pipefail

usage() { echo "usage: herdr-say [--kind KIND] [--artifact REF] TARGET MESSAGE | --parked TARGET" >&2; }
here="$(dirname "$(readlink -f "$0")")"

# The latest parked line naming TARGET by pane or name. A line without name is
# the lane owner: the lane's name, its log's stem. Each line that is not one
# JSON object is named once on stderr and skipped, so it hides nothing else.
parked() {
  local out logs=("$("$here/../../../scripts/octo-lite-state")"/lanes/*.handoffs.jsonl)
  [[ -f "${logs[0]}" ]] || return 1
  out="$(jq -nRr --arg t "$1" '[inputs | (try fromjson catch null) as $o
      | if $o | type == "object"
        then $o | .lane = (input_filename | split("/") | last | rtrimstr(".handoffs.jsonl"))
        else "herdr-say: \(input_filename): line \(input_line_number) is not a JSON object; skipped" end]
    | (.[] | strings), ([.[] | objects | select(.kind == "parked") | .name //= .lane
      | select(.pane == $t or .name == $t)] | sort_by(.at) | last // empty | tojson)' "${logs[@]}")"
  sed -n '/^herdr-say: /p' <<<"$out" >&2
  grep '^{' <<<"$out"
}

while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --kind|--artifact) shift 2 ;;   # accepted for caller compatibility, unused
    --parked) (($# == 2)) || { usage; exit 64; }; parked "$2"; exit ;;
    --) shift; break ;;
    -*) echo "herdr-say: unknown option $1" >&2; exit 64 ;;
    *) break ;;
  esac
done
(($# == 2)) || { usage; exit 64; }
target="$1"; message="$2"

prompt() {
  rc=0; at="$(date -u +%FT%T.%3NZ)"
  out="$(herdr agent prompt "$1" "$message" --wait --until working --until idle 2>&1)" || rc=$?
}
code() { jq -r '.error.code // empty' <<<"$out" 2>/dev/null || true; }
# Exit unless the last prompt landed. A blocked target is a retry, not a
# failure: it is sitting on a dialog and Herdr correctly declined to type past it.
landed() {
  [[ "$rc" == 0 ]] && return
  [[ "$(code)" == agent_blocked ]] && {
    echo "herdr-say: $target is blocked on interactive input; not delivered" >&2; exit 75; }
  printf '%s\n' "$out" >&2
  exit "$rc"
}
# The last send's reply in the transcript of pane $1's Claude session: the
# first reply after the record carrying the message since the send, a user
# record or the queued_command a running turn took it in by, either may wrap
# it; Claude records a slash command as its name and args in tags. File order
# decides: a queued_command is stamped before replies written ahead of it.
# Waits a few seconds, as a rate-limit refusal lands within 1.4s, and while
# the message is enqueued behind a turn Herdr shows running (working, or
# blocked on a dialog). Claude takes it in at once when that turn ends, so once
# Herdr shows the turn ended or Claude gone, the same few seconds decide.
# Prints the reply, or "queued" for a message never taken in; fails for no
# reply or no Claude session. A transcript is null until a fresh agent's first message lands, and
# is read from its tail: it grows to hundreds of MB, and a take-in lands
# within 20 lines of its enqueue.
reply() {
  local transcript="" r n=0
  while ((n < 10)); do
    [[ -n "$transcript" ]] || transcript="$("$here/herdr-claude-session" "$1" | jq -r '.transcript // empty')" || return 1
    r="$(tail -n 100 "$transcript" 2>/dev/null | jq -cn --arg at "$at" --arg m "$message" '
      ($m | [capture("^(?<n>/\\S+)\\s*(?<a>[\\s\\S]*)") | "<command-name>\(.n)</command-name>", "<command-args>\(.a)</command-args>"]) as $cmd
      | def carries: type == "string" and (contains($m) or $cmd != [] and (. as $s | all($cmd[]; . as $x | $s | contains($x))));
      [inputs | select(.timestamp >= $at)] as $t
      | ($t | map(.type == "user" and (.message.content | carries)
          or .attachment.type == "queued_command" and (.attachment.prompt | carries)) | index(true)) as $i
      | if $i then first($t[$i:][] | select(.type == "assistant" and .isSidechain == false)) // empty
        elif any($t[]; .operation == "enqueue" and (.content | carries)) then "queued" else empty end' 2>/dev/null)"
    case "$r" in
      '"queued"') herdr agent get "$1" 2>/dev/null |
          jq -e '.result.agent.agent_status | IN("working", "blocked")' >/dev/null || n=$((n + 1)) ;;
      '') n=$((n + 1)) ;;
      *) break ;;
    esac
    sleep 0.5
  done
  [[ -n "$r" ]] && printf '%s\n' "$r"
}
limited() {
  r="$(reply "$pane")" || return 1
  [[ "$r" != '"queued"' ]] || {
    echo "herdr-say: $target: message never taken in; its running turn ended or its Claude exited first" >&2; exit 1; }
  [[ "$(jq -r .error <<<"$r")" == rate_limit ]]
}

# One send, the first and every re-send: the message goes to $name, resuming
# first a target Herdr does not find that a parked line names (one parked
# during a wait is named by its pane or name); $pane is then its pane.
send() {
  prompt "$name"
  if [[ "$rc" != 0 && "$(code)" == agent_not_found ]] && line="$(parked "$name")"; then
    name="$(jq -r .name <<<"$line")"
    if ! herdr agent get "$name" >/dev/null 2>&1; then
      resume=(--cwd "$(jq -r .cwd <<<"$line")" --name "$name" --resume "$(jq -r .session <<<"$line")")
      if [[ "$name" == "$(jq -r .lane <<<"$line")" ]]; then
        started="$("$here/../../../scripts/octo-lite-start" "${resume[@]}")"
      else
        started="$("$here/herdr-spawn" --workspace "${HERDR_WORKSPACE_ID:-}" --label "$name" \
          --role "$(jq -r '.role // (.name | sub("-[a-z0-9]+-[0-9]+$"; ""))' <<<"$line")" "${resume[@]}" -- claude)"
      fi
      name="$(sed -n 's/.* pane=\([^ ]*\).*/\1/p' <<<"$started")"
      echo "pane=$name"
    fi
    prompt "$name"
  fi
  landed
  pane="$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.pane_id // empty')" || exit 0
}

name="$target"
send
waits=(60 120 240 480 960 1800 1800 1800) sends=1 # about two hours in all
while limited; do
  ((sends <= ${#waits[@]})) || {
    echo "herdr-say: $target not processed: API rate limit at all $sends sends; last error: $(jq -r '.message.content[0].text' <<<"$r")" >&2
    exit 69; }
  sleep "${waits[sends - 1]}"
  send; sends=$((sends + 1))
done
