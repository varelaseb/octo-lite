#!/usr/bin/env bash
# Send one message to a Herdr agent, and confirm it actually landed.
#
# This is a thin wrapper over a single native Herdr command:
#   herdr agent prompt TARGET TEXT --wait --until working --until idle
#
# Native Herdr already solves what this script used to solve by hand. It
# refuses a blocked agent outright (`agent_blocked`) rather than typing into an
# open dialog, so no modal guard is needed; and `--wait --until` returns only on
# an observed state change, so delivery is confirmed by Herdr rather than by an
# acknowledgement the agent sends about itself.
#
# A Claude agent whose turn dies at once on an API rate limit (credentials
# cooling down) has not processed the message, though Herdr saw it work. After
# each send the pane's Claude session (herdr-claude-session) decides: the
# message is processed unless the first reply after the send, within a few
# seconds, is a rate-limit error. Otherwise the same message is sent again,
# waits doubling from a minute, capped, about two hours in all. The error names
# no time it clears. Codex and pi keep no Claude session: the state change alone
# confirms.
#
# Exit codes are the contract callers rely on, including
# `herdr-wake`, Spec Chat's wake provider:
#   0   delivered, and Herdr observed the agent change state; a Claude agent
#       also processed it
#   69  not processed: a Claude agent's turn died on an API rate limit at every
#       send; stderr names the target, the number of sends, the last API error;
#       every re-send is already spent, so the caller never sends it again
#   75  not delivered now because the target is blocked on interactive input;
#       the caller should retry once the target is free
#   >0  anything else
#
# A target Herdr does not find may be parked: the latest parked line naming it,
# in any lane hand-off log of the caller's Herdr session (octo-lite-state),
# decides; another session's lanes repeat its ids. A live agent under the
# line's name gets the message; otherwise the agent is resumed first (an owner,
# the lane's name, in a new lane space; a worker in the caller's space), and its
# new pane= is printed.
# `herdr-say --parked TARGET` prints that line, or exits 1 when there is none.
set -euo pipefail

usage() { echo "usage: herdr-say [--kind KIND] [--artifact REF] TARGET MESSAGE | --parked TARGET" >&2; }
here="$(dirname "$(readlink -f "$0")")"

# The latest parked line naming TARGET by pane or name. A line without name is
# the lane owner: the lane's name, its log's stem.
parked() {
  local line logs=("$("$here/../../../scripts/octo-lite-state")"/lanes/*.handoffs.jsonl)
  [[ -f "${logs[0]}" ]] || return 1
  line="$(jq -nc --arg t "$1" '[inputs | select(.kind == "parked")
    | .lane = (input_filename | split("/") | last | rtrimstr(".handoffs.jsonl"))
    | .name //= .lane
    | select(.pane == $t or .name == $t)] | sort_by(.at) | last // empty' "${logs[@]}")" &&
    [[ -n "$line" ]] && printf '%s\n' "$line"
}

while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --kind|--artifact) shift 2 ;;   # accepted for caller compatibility, unused
    --parked) (($# == 2)) || { usage; exit 64; }; parked "$2"; exit ;;
    --) shift; break ;;
    -*) echo "herdr-say: unknown option $1" >&2; exit 64 ;;
    *) break ;;
  esac
done
(($# == 2)) || { usage; exit 64; }
target="$1"; message="$2"

prompt() {
  rc=0; at="$(date -u +%FT%T.%3NZ)"
  out="$(herdr agent prompt "$1" "$message" --wait --until working --until idle 2>&1)" || rc=$?
}
code() { jq -r '.error.code // empty' <<<"$out" 2>/dev/null || true; }
# Exit unless the last prompt landed. A blocked target is a retry, not a
# failure: it is sitting on a dialog and Herdr correctly declined to type past it.
landed() {
  [[ "$rc" == 0 ]] && return
  [[ "$(code)" == agent_blocked ]] && {
    echo "herdr-say: $target is blocked on interactive input; not delivered" >&2; exit 75; }
  printf '%s\n' "$out" >&2
  exit "$rc"
}
# The first reply since the last send in the transcript of pane $1's Claude
# session, waiting a few seconds: a rate-limit refusal lands within 1.4s. Fails
# for no reply or no Claude session. A transcript is null until a fresh agent's
# first message lands, and is read from its tail: it grows to hundreds of MB.
reply() {
  local transcript="" r
  for _ in {1..10}; do
    [[ -n "$transcript" ]] || transcript="$("$here/herdr-claude-session" "$1" | jq -r '.transcript // empty')" || return 1
    r="$(tail -n 100 "$transcript" 2>/dev/null | jq -cn --arg at "$at" 'first(inputs
      | select(.type == "assistant" and .isSidechain == false and .timestamp >= $at)) // empty' 2>/dev/null)"
    [[ -n "$r" ]] && { printf '%s\n' "$r"; return; }
    sleep 0.5
  done
  return 1
}
limited() { r="$(reply "$pane")" && [[ "$(jq -r .error <<<"$r")" == rate_limit ]]; }

name="$target"
prompt "$name"
if [[ "$rc" != 0 && "$(code)" == agent_not_found ]] && line="$(parked "$target")"; then
  name="$(jq -r .name <<<"$line")"
  if ! herdr agent get "$name" >/dev/null 2>&1; then
    resume=(--cwd "$(jq -r .cwd <<<"$line")" --name "$name" --resume "$(jq -r .session <<<"$line")")
    if [[ "$name" == "$(jq -r .lane <<<"$line")" ]]; then
      started="$("$here/../../../scripts/octo-lite-start" "${resume[@]}")"
    else
      started="$("$here/herdr-spawn" --workspace "${HERDR_WORKSPACE_ID:-}" --label "$name" \
        --role "$(jq -r '.role // empty' <<<"$line")" "${resume[@]}" -- claude)"
    fi
    name="$(sed -n 's/.* pane=\([^ ]*\).*/\1/p' <<<"$started")"
    echo "pane=$name"
  fi
  prompt "$name"
fi
landed

pane="$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.pane_id // empty')" || exit 0
waits=(60 120 240 480 960 1800 1800 1800) sends=1
while limited; do
  ((sends <= ${#waits[@]})) || {
    echo "herdr-say: $target not processed: API rate limit at all $sends sends; last error: $(jq -r '.message.content[0].text' <<<"$r")" >&2
    exit 69; }
  sleep "${waits[sends - 1]}"
  prompt "$name"; landed; sends=$((sends + 1))
done
