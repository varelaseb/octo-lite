#!/usr/bin/env bash
# Print the Claude session of Herdr pane PANE as one JSON line: Claude's own
# record ~/.claude/sessions/<pid>.json plus transcript, the path of its
# ~/.claude/projects/*/<sessionId>.jsonl, null before its first message.
# Exit 1 when no record counts. herdr-close --park, herdr-say, and a native
# report share it.
#
# A record counts when its live process carries HERDR_PANE_ID=PANE and the
# caller's HERDR_SESSION (unset in both for the default session), foreground
# or not: a spare Claude claimed into the pane is its live agent. Its
# procStart must be that process's start time, field 22 of /proc/<pid>/stat,
# so a record an ended Claude left at a pid since reused is never read. Of
# those, the pane's session is the one whose transcript holds the latest reply,
# an assistant record off any sidechain. Claude appends in order, so a
# transcript's latest reply is its last one, read from its end: a transcript
# grows to hundreds of MB, and the lookup's cost must not grow with it.
set -uo pipefail
# True when the process behind environ file $1 runs in the caller's Herdr
# session, HERDR_SESSION unset in both for the default one, and carries the
# line $2 when given. Unreadable entries are silently not ours. The one
# session-membership check: herdr-close sources this script for it, and only it.
ours() {
  local vars
  vars="$(tr '\0' '\n' 2>/dev/null <"$1")" && { (($# == 1)) || grep -qxF "$2" <<<"$vars"; } &&
    [[ "$(sed -n 's/^HERDR_SESSION=//p' <<<"$vars")" == "${HERDR_SESSION:-}" ]]
}
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0
(($# == 1)) || { echo "usage: herdr-claude-session PANE" >&2; exit 64; }

best=""; latest=""
for file in "$HOME"/.claude/sessions/[0-9]*.json; do
  pid="${file##*/}"; pid="${pid%.json}"
  ours /proc/"$pid"/environ "HERDR_PANE_ID=$1" || continue
  [[ "$(jq -r .procStart "$file")" == "$(cut -d' ' -f22 /proc/"$pid"/stat 2>/dev/null)" ]] || continue
  transcripts=("$HOME"/.claude/projects/*/"$(jq -r .sessionId "$file")".jsonl)
  transcript=""; at=""
  if [[ -f "${transcripts[0]}" ]]; then
    transcript="${transcripts[0]}"
    at="$(tac "$transcript" 2>/dev/null |
      jq -rn 'first(inputs | select(.type == "assistant" and .isSidechain == false) | .timestamp) // ""')"
  fi
  [[ -z "$best" || "$at" > "$latest" ]] && { best="$file"; latest="$at"; path="$transcript"; }
done
[[ -n "$best" ]] || exit 1
jq -c --arg t "$path" '.transcript = (if $t == "" then null else $t end)' "$best"
