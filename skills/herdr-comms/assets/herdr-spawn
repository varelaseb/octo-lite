#!/usr/bin/env bash
# Spawn one agent in its own Herdr tab, at a given worktree, under a role.
#
# This is a thin wrapper over two native Herdr commands:
#   herdr tab create   -> a tab and root pane at the worktree
#   herdr agent start  -> the agent adopts that pane
# Everything else here exists because those two have real failure modes: a
# freshly created pane is not yet at a shell prompt, and the agent may open a
# trusted-folder dialog that traps the session. Both are handled and verified.
#
# The runtime (model, effort, skills) comes from the agent definition and the
# CLI's own defaults. This script pins none of it.
#
# --reload PANE LAST FIRST spawns into a running Claude agent's own pane instead
# of a new tab (spec/domains/herdr-transport.spec.html#transport-reload).
set -euo pipefail
here="$(dirname "$(readlink -f "$0")")"

argv=("$@") workspace="" name="" label="" cwd="$PWD" role="" resume="" reload=""
# The operating model is inherited: each spawn exports it into the tab it creates,
# so every child spawned from there defaults to the same file.
model="${OCTO_LITE_OPERATING_MODEL:-}"

usage() {
  cat <<'EOF'
usage:
  herdr-spawn --workspace ID --name NAME --label LABEL --cwd DIR --role ROLE \
    [--operating-model FILE] [--resume SESSION] -- claude|codex|pi
  herdr-spawn --reload PANE LAST FIRST

Spawn bare, then send the brief with herdr-say. Claude gets --name NAME and
--agent ROLE from --role. --resume SESSION continues a parked Claude session (Claude only).
--reload, run by a Claude agent on its own pane as a turn's last step, returns
at once; once the agent has gone quiet it sends LAST, then replaces the agent
in PANE with a fresh Claude under its old name, role, and goal, and sends FIRST.

Prints: name= role= tab= pane= cwd= contract= provider_session_id=
EOF
}

while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --workspace) workspace="${2:?}"; shift 2 ;;
    --name) name="${2:?}"; shift 2 ;;
    --label) label="${2:?}"; shift 2 ;;
    --cwd) cwd="${2:?}"; shift 2 ;;
    --role) role="${2:?}"; shift 2 ;;
    --operating-model) model="${2:?}"; shift 2 ;;
    --resume) resume="${2:?}"; shift 2 ;;
    --reload) (($# == 4)) || { usage >&2; exit 64; }; reload="$2" last="$3" first="$4"; set -- claude; break ;;
    --direct) shift ;;                 # accepted and ignored; kept for callers
    --) shift; break ;;
    *) echo "herdr-spawn: unknown option $1" >&2; exit 64 ;;
  esac
done
[[ -n "$reload" || -n "$workspace" && -n "$name" && -n "$role" && $# -gt 0 ]] || { usage >&2; exit 64; }
[[ -d "$cwd" ]] || { echo "herdr-spawn: no such worktree: $cwd" >&2; exit 66; }
cwd="$(cd "$cwd" && pwd -P)"
if [[ -n "$model" ]]; then
  [[ -f "$model" ]] || { echo "herdr-spawn: no such operating model: $model" >&2; exit 66; }
  model="$(cd "$(dirname "$model")" && pwd -P)/$(basename "$model")"
fi

runtime="$(basename "$1")"
case "$runtime" in
  claude|codex|pi) kind="$runtime" ;;
  *) echo "herdr-spawn: persistent tabs require claude, codex, or pi, got $runtime" >&2; exit 65 ;;
esac
# An inline prompt makes herdr agent start wait for a readiness it never sees and
# time out, so the runtime takes no arguments.
(($# == 1)) || { echo "herdr-spawn: no args after the runtime; spawn bare, then send the brief with herdr-say" >&2; exit 64; }
# Only Claude keeps the per-process session file parking resumes from.
[[ -z "$resume" || "$kind" == claude ]] || { echo "herdr-spawn: --resume is Claude only" >&2; exit 64; }

# A reload (spec/domains/herdr-transport.spec.html#transport-reload) ends the
# running Claude agent of PANE once it has gone quiet and had its hand-over,
# then goes on below as a spawn into that pane, under the name, role, and goal
# the old session ran under. Run by that agent on itself, it returns at once
# and goes on in a session of its own, so it outlives the Claude it ends.
if [[ -n "$reload" ]]; then
  pane="$reload"
  if [[ -z "${HERDR_SPAWN_RELOADING:-}" ]]; then
    # Only Claude keeps a session to end and a goal to carry.
    session="$("$here/herdr-claude-session" "$pane")" ||
      { echo "herdr-spawn: no Claude session in $pane; reload is Claude only" >&2; exit 65; }
    # Its stderr is the pane's terminal, Claude's stdin, so a failure once that
    # Claude has ended prints at the shell prompt it leaves in the pane.
    HERDR_SPAWN_RELOADING=1 setsid -f "$here/herdr-spawn" "${argv[@]}" \
      </dev/null >/dev/null 2>"/proc/$(jq -r .pid <<<"$session")/fd/0"
    exit
  fi
  unset HERDR_SPAWN_RELOADING
  # True when a human has typed into the agent's prompt. Its input line is the
  # last one opening on U+276F and a no-break space; Claude draws its own
  # suggestion there dim, which is nothing typed.
  typed() {
    herdr pane read "$pane" --source visible --lines 60 --format ansi 2>/dev/null |
      sed -n $'s/\e\\[2m[^\e]*//g; s/\e\\[[0-9;]*m//g; s/^\xe2\x9d\xaf\xc2\xa0//p' | tail -1 | grep -q '[^[:space:]]'
  }
  # Until the agent has stayed idle at one Herdr state, with nothing typed, for
  # $1 reads a minute apart after the first: a read that finds it working, at
  # a new state (it worked between two reads), or with text typed starts them
  # again. A pane Herdr no longer finds leaves nothing to reload.
  quiet() {
    local at="" s n=0
    while :; do
      s="$(herdr agent get "$pane" 2>/dev/null | jq -r '.result.agent | "\(.agent_status) \(.state_change_seq)"')" || exit 1
      if [[ "$s" != @(idle|done)\ * ]] || typed; then at=""
      elif [[ "$s" != "$at" ]]; then at="$s" n=0
      fi
      if [[ -n "$at" ]] && ((n++ >= $1)); then return; fi
      sleep 60
    done
  }
  # The session's latest transcript record of type $1, or nothing.
  latest() { grep -F "\"type\":\"$1\"" "$transcript" 2>/dev/null | tail -1 || :; }
  quiet 10
  "$here/herdr-say" "$pane" "$last" >/dev/null
  quiet 0
  # It ends the agent at once, so nothing reaches it between the last quiet
  # read and its end, to be lost with it. Its transcript, read after, is final.
  session="$("$here/herdr-claude-session" "$pane")"
  kill -TERM "$(jq -r .pid <<<"$session")"
  transcript="$(jq -r '.transcript // empty' <<<"$session")"
  name="$(jq -r .name <<<"$session")"
  role="$(latest agent-setting | jq -r '.agentSetting // empty')"
  # A goal Claude ended, met or failed, is none.
  goal="$(latest goal_status | jq -r 'select(.attachment.met == false and (.attachment.failed | not)) | .attachment.condition')"
  # Herdr holds an ended agent's name a while, refusing it to a start, so the
  # spawn goes on, bounded, once Herdr finds no agent in the pane. Until the
  # start, a send to the pane fails at its sender, and a failure prints at the
  # shell prompt the agent left.
  for _ in $(seq 1 60); do herdr agent get "$pane" >/dev/null 2>&1 || break; sleep 1; done
fi

# The box comes current before the agent starts, its contract included: when
# the octo-lite clone moved since the install last ran, run the after-pull step
# the install published (install.spec.html#install-after-pull). The step records
# the commit it ran at, so it runs once per move. Parallel spawns queue on the
# onboarding file's lock, and those after the first find nothing to do. A
# failing step is printed and the spawn goes on. No onboarding file, no step.
onboarding="${XDG_STATE_HOME:-$HOME/.local/state}/octo-lite/onboarding.toml"
if [[ -f "$onboarding" ]]; then
  exec 9<"$onboarding"
  flock 9
  mapfile -t record < <(python3 -c 'import sys, tomllib
d = tomllib.load(open(sys.argv[1], "rb"))
print(d.get("commit", ""), *d.get("after_pull", []), sep="\n")' "$onboarding")
  step=("${record[@]:1}")
  if ((${#step[@]})) && [[ "$(git -C "$(dirname "${step[0]}")" rev-parse HEAD 2>/dev/null)" != "${record[0]}" ]]; then
    err="$("${step[@]}" 2>&1 >/dev/null </dev/null 9<&-)" ||
      printf '%s\nherdr-spawn: after-pull step failed; spawning anyway\n' "$err" >&2
  fi
  exec 9<&-
fi

# The role contract. A Claude agent loads it itself through `--agent ROLE`,
# derived from --role. Codex has no custom-agent file, so the contract goes
# in at the developer layer as one TOML string argv. Delivered as a prompt
# instead, Codex treats it as a task and starts working it. Pi has neither,
# and appends the contract file to its system prompt.
#
# The installed profile is the lookup, so a contract owned by any peer
# repository resolves without this script knowing which one.
contract_file="$HOME/.claude/agents/$role.md"
contract="not-found"
# `agent start --kind` supplies the executable.
if [[ "$kind" == claude ]]; then
  contract="loaded-by-agent-flag"
  # --name puts the Herdr name in Claude's own session list, resumed too.
  launch_argv=(--name "$name" --agent "$role")
  [[ -z "$resume" ]] || launch_argv+=(--resume "$resume")
elif [[ "$kind" == pi ]]; then
  launch_argv=()
  if [[ -f "$contract_file" ]]; then
    contract="appended-system-prompt"
    launch_argv=(--append-system-prompt "$contract_file")
  else
    echo "herdr-spawn: no $role contract at $contract_file; the agent does not know its bounds" >&2
  fi
else
  # --no-daemon keeps the thread and its commands in this tab's process tree,
  # tagged with HERDR_TAB_ID, so herdr-close can end all of it. The shared
  # app-server daemon would outlive the tab.
  launch_argv=(--no-daemon)
  if [[ -f "$contract_file" ]]; then
    contract="developer-instructions"
  else
    echo "herdr-spawn: no $role contract at $contract_file; the agent does not know its bounds" >&2
  fi
fi

# An optional operating model, handed over at start so the agent needs no global
# instruction file. Claude and pi append it to their system prompt, pi ahead of
# the contract. Codex takes it ahead of the contract in the one
# developer_instructions string.
if [[ "$kind" == claude ]]; then
  [[ -z "$model" ]] || launch_argv=(--append-system-prompt-file "$model" "${launch_argv[@]}")
elif [[ "$kind" == pi ]]; then
  [[ -z "$model" ]] || launch_argv=(--append-system-prompt "$model" "${launch_argv[@]}")
elif [[ -n "$model" || -f "$contract_file" ]]; then
  instructions="$({ [[ -z "$model" ]] || { cat "$model"; echo; }; [[ ! -f "$contract_file" ]] || cat "$contract_file"; } | jq -Rs .)"
  launch_argv=(-c "developer_instructions=$instructions" "${launch_argv[@]}")
fi

# A tab starts with the Herdr server's environment, not the caller's. HOME is
# forwarded so the agent and every descendant keep the caller's git identity,
# consent, and sessions; the model path likewise. TMPDIR is the agent's own
# scratch folder, named after its session and name, where every program it
# runs puts its temporary files, and herdr-close removes it with the agent
# (disk.spec.html#scratch-folder). Every folder made for it is the user's
# alone, whatever the umask.
# A reloaded pane has them already.
tab=""
if [[ -z "$reload" ]]; then
  scratch="$("$here/../../../scripts/octo-lite-state" --scratch "$name")"
  (umask 077 && mkdir -p -- "$scratch")
  tab_env=(--env "HOME=$HOME" --env "TMPDIR=$scratch")
  [[ -z "$model" ]] || tab_env+=(--env "OCTO_LITE_OPERATING_MODEL=$model")
  out="$(herdr tab create --workspace "$workspace" --label "$label" --cwd "$cwd" "${tab_env[@]}" --no-focus)"
  tab="$(jq -r '.result.tab.tab_id // empty' <<<"$out")"
  pane="$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")"
  [[ -n "$tab" && -n "$pane" ]] || { echo "herdr-spawn: tab create returned no tab or pane" >&2; exit 1; }
fi

# A failed spawn closes the tab it created; a reload created none, so its pane
# stays, and its failures name no tab.
close_orphan_tab() { [[ -z "$tab" ]] || herdr tab close "$tab" >/dev/null 2>&1 || true; }

# A new root pane may not have reached its shell prompt yet; herdr reports that
# as the structured error agent_pane_busy. Only that code retries. Any other
# failure, or exhausting the retries, closes the tab so no orphan survives.
retries="${HERDR_SPAWN_START_RETRIES:-8}"; delay="0.5"; attempt=0
while :; do
  attempt=$((attempt + 1)); rc=0
  err="$(herdr agent start "$name" --kind "$kind" --pane "$pane" -- "${launch_argv[@]}" 2>&1 >/dev/null)" || rc=$?
  [[ "$rc" == 0 ]] && break
  code="$(jq -r '.error.code // empty' <<<"$err" 2>/dev/null || true)"
  # herdr registers the agent but reports agent_not_ready while the agent's own
  # trusted-folder dialog is open. That is a started agent waiting on a
  # keystroke, not a failed start; the dialog step below is what clears it.
  [[ "$code" == agent_not_ready ]] && break
  if [[ "$code" != agent_pane_busy ]]; then
    [[ -n "$err" ]] && printf '%s\n' "$err" >&2
    echo "herdr-spawn: agent start failed${tab:+; closing tab $tab}" >&2
    close_orphan_tab; exit "$rc"
  fi
  if (( attempt >= retries )); then
    printf '%s\n' "$err" >&2
    echo "herdr-spawn: pane still busy after $retries attempts${tab:+; closing tab $tab}" >&2
    close_orphan_tab; exit "$rc"
  fi
  sleep "$delay"; [[ "$delay" == 0.5 ]] && delay=1 || delay=2
done

# Answer the startup dialogs, then verify they actually cleared.
#
# Two agents, two shapes. Claude marks the selected row with U+276F and offers
# "Yes, I trust this folder"; Codex marks it with U+203A and offers
# "1. Yes, continue" or, since 2026-09, "1. Trust and continue". Codex also
# asks, separately, to trust each hook before it will run, which is a single
# keypress rather than a menu.
#
# Never confirm blindly. The highlighted row is whatever the CLI last left
# selected, and for a previously declined directory it is the refusal, so a bare
# Enter kills the agent being spawned. Read the row, move onto the affirmative,
# verify it moved, and only then confirm.
#
# Three states matter: a dialog is open (0), verified clear (1), read failed
# (2). A failed read is not evidence of clearing, so it retries and then fails
# closed rather than reporting a session that is really still trapped.
pane_text() { herdr pane read "$pane" --source visible --lines 60 2>/dev/null; }

dialog_state() {
  local text
  text="$(pane_text)" || return 2
  grep -qiE 'Quick safety check|trust this folder|trust the contents of this directory|Trust and continue|Press t to trust' <<<"$text" && return 0
  is_appearance_wizard <<<"$text" && return 0
  return 1
}

# Claude's first-run appearance wizard. Every option is a preference and none of
# them is destructive, so unlike a trust dialog this one may be confirmed as it
# stands. It is recognised by its own options rather than by a title, so a
# reworded heading does not turn it into an unrecognised dialog.
is_appearance_wizard() {
  local text; text="$(cat)"
  grep -qiE 'Dark mode' <<<"$text" && grep -qiE 'Light mode' <<<"$text"
}

# The row the CLI has highlighted, for either marker.
selected_row() { pane_text | grep -E '^[[:space:]]*(❯|›)' | head -1; }

send_key() {
  herdr pane send-keys "$pane" "$1" >/dev/null 2>&1 || {
    echo "herdr-spawn: dialog keystroke failed${tab:+; closing tab $tab}" >&2
    close_orphan_tab; exit 69; }
}

cleared=0 tries="${HERDR_SPAWN_TRUST_RETRIES:-14}"
# A reloaded pane's folder is trusted already, and its screen still shows the
# old conversation, which no dialog may be read from.
[[ -z "$reload" ]] || cleared=1 tries=0
for _ in $(seq 1 "$tries"); do
  state=0; dialog_state || state=$?
  [[ "$state" == 1 ]] && { cleared=1; break; }
  if [[ "$state" == 0 ]]; then
    if pane_text | grep -qiE 'Press t to trust'; then
      # hook trust: a single key, not a menu
      herdr pane send-text "$pane" "t" >/dev/null 2>&1 || send_key t
    elif pane_text | is_appearance_wizard; then
      send_key Enter
    elif selected_row | grep -qiE 'trust (this folder|the contents)|Yes, continue|Trust and continue|^[^A-Za-z]*[0-9]+\. *Yes'; then
      send_key Enter
    else
      send_key Down
    fi
  fi
  sleep 1
done
if [[ "$cleared" != 1 ]]; then
  state=0; dialog_state || state=$?
  case "$state" in
    1) : ;;
    2) echo "herdr-spawn: could not read the pane to verify the dialog; failing closed" >&2
       close_orphan_tab; exit 69 ;;
    *) # Print what was actually on screen: an unrecognised dialog shape is a
       # fixable report, where a bare "did not clear" is a guessing game.
       echo "herdr-spawn: a startup dialog did not clear; failing closed. Pane showed:" >&2
       pane_text | grep -vE '^[[:space:]]*$' | tail -12 >&2
       close_orphan_tab; exit 69 ;;
  esac
fi

# The dialogs clearing does not mean the agent can accept a prompt yet: it may
# still be booting, and a prompt fired into that window is never reacted to -
# Herdr reports `agent_prompt_stalled` and the message sits typed, unsent. Wait
# until the agent reports its own status before calling the spawn done. Herdr
# reports a Claude agent idle a few seconds after its process starts, drawn or
# not, so a Claude agent is ready once its session record (herdr-claude-session)
# holds the status Claude writes there once its prompt takes input.
provider_session_id=""; ready=""
for _ in $(seq 1 "${HERDR_SPAWN_READY_RETRIES:-20}"); do
  info="$(herdr agent get "$name" 2>/dev/null || true)"
  provider_session_id="$(jq -r '.result.agent.agent_session.value // empty' <<<"$info" 2>/dev/null || true)"
  agent_status="$(jq -r '.result.agent.agent_status // empty' <<<"$info" 2>/dev/null || true)"
  # Readiness is the reported status, not the session id: Herdr resolves a
  # provider session on some hosts and not others, but a status means the agent
  # is attached.
  [[ -n "$agent_status" ]] && { [[ "$kind" != claude ]] ||
    "$here/herdr-claude-session" "$pane" 2>/dev/null | jq -e .status >/dev/null; } && { ready=1; break; }
  sleep 1
done
if [[ -z "$ready" ]]; then
  echo "herdr-spawn: agent never reported a status; it is not ready for prompts" >&2
  close_orphan_tab; exit 69
fi
[[ -n "$provider_session_id" ]] || provider_session_id="herdr:$name"

# The fresh session opens on FIRST, then takes up the old one's goal.
if [[ -n "$reload" ]]; then
  "$here/herdr-say" "$pane" "$first" >/dev/null
  [[ -z "$goal" ]] || "$here/herdr-say" "$pane" "/goal $goal" >/dev/null
fi

echo "name=$name role=$role tab=$tab pane=$pane cwd=$cwd contract=$contract provider_session_id=$provider_session_id"
