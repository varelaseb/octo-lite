#!/usr/bin/env bash
# Spawn one agent in its own Herdr tab, at a given worktree, under a role.
#
# This is a thin wrapper over two native Herdr commands:
#   herdr tab create   -> a tab and root pane at the worktree
#   herdr agent start  -> the agent adopts that pane
# Everything else here exists because those two have real failure modes: a
# freshly created pane is not yet at a shell prompt, and the agent may open a
# trusted-folder dialog that traps the session. Both are handled and verified.
#
# The runtime (model, effort, skills) comes from the agent definition and the
# CLI's own defaults. This script pins none of it.
set -euo pipefail

workspace=""; name=""; label=""; cwd="$PWD"; role=""

usage() {
  cat <<'EOF'
usage:
  herdr-spawn --workspace ID --name NAME --label LABEL --cwd DIR --role ROLE \
    -- claude --agent ROLE [CLAUDE_ARGS...]
  herdr-spawn --workspace ID --name NAME --label LABEL --cwd DIR --role ROLE \
    -- codex [CODEX_ARGS...]

Prints: name= role= tab= pane= cwd= remote_control= provider_session_id=
EOF
}

while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --workspace) workspace="${2:?}"; shift 2 ;;
    --name) name="${2:?}"; shift 2 ;;
    --label) label="${2:?}"; shift 2 ;;
    --cwd) cwd="${2:?}"; shift 2 ;;
    --role) role="${2:?}"; shift 2 ;;
    --direct) shift ;;                 # accepted and ignored; kept for callers
    --) shift; break ;;
    *) echo "herdr-spawn: unknown option $1" >&2; exit 64 ;;
  esac
done
[[ -n "$workspace" && -n "$name" && -n "$role" && $# -gt 0 ]] || { usage >&2; exit 64; }
[[ -d "$cwd" ]] || { echo "herdr-spawn: no such worktree: $cwd" >&2; exit 66; }
cwd="$(cd "$cwd" && pwd -P)"

runtime="$(basename "$1")"
case "$runtime" in
  claude|codex) kind="$runtime" ;;
  *) echo "herdr-spawn: persistent tabs require claude or codex, got $runtime" >&2; exit 65 ;;
esac

remote_control="disabled"
if [[ "$kind" == codex ]]; then
  # Shared app-server capability, and optional: it powers Codex's own mobile
  # approvals, which a spawned agent does not need in order to run. A system
  # Codex has no standalone package to start it from, so a failure here is
  # reported and the spawn continues. Done before the tab exists either way, so
  # it can never leave an orphan.
  if "$1" remote-control start --json >/dev/null 2>&1; then
    remote_control="enabled"
  else
    remote_control="unavailable"
    echo "herdr-spawn: Codex Remote Control unavailable; continuing without it" >&2
  fi
  launch_argv=("${@:2}")   # `agent start --kind codex` supplies the executable
else
  launch_argv=("${@:2}")
fi

out="$(herdr tab create --workspace "$workspace" --label "$label" --cwd "$cwd" --no-focus)"
tab="$(jq -r '.result.tab.tab_id // empty' <<<"$out")"
pane="$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")"
[[ -n "$tab" && -n "$pane" ]] || { echo "herdr-spawn: tab create returned no tab or pane" >&2; exit 1; }

close_orphan_tab() { herdr tab close "$tab" >/dev/null 2>&1 || true; }

# A new root pane may not have reached its shell prompt yet; herdr reports that
# as the structured error agent_pane_busy. Only that code retries. Any other
# failure, or exhausting the retries, closes the tab so no orphan survives.
retries="${HERDR_SPAWN_START_RETRIES:-8}"; delay="0.5"; attempt=0
while :; do
  attempt=$((attempt + 1)); rc=0
  err="$(herdr agent start "$name" --kind "$kind" --pane "$pane" -- "${launch_argv[@]}" 2>&1 >/dev/null)" || rc=$?
  [[ "$rc" == 0 ]] && break
  code="$(jq -r '.error.code // empty' <<<"$err" 2>/dev/null || true)"
  # herdr registers the agent but reports agent_not_ready while the agent's own
  # trusted-folder dialog is open. That is a started agent waiting on a
  # keystroke, not a failed start; the dialog step below is what clears it.
  [[ "$code" == agent_not_ready ]] && break
  if [[ "$code" != agent_pane_busy ]]; then
    [[ -n "$err" ]] && printf '%s\n' "$err" >&2
    echo "herdr-spawn: agent start failed; closing tab $tab" >&2
    close_orphan_tab; exit "$rc"
  fi
  if (( attempt >= retries )); then
    printf '%s\n' "$err" >&2
    echo "herdr-spawn: pane still busy after $retries attempts; closing tab $tab" >&2
    close_orphan_tab; exit "$rc"
  fi
  sleep "$delay"; [[ "$delay" == 0.5 ]] && delay=1 || delay=2
done

# Answer the one-time trusted-folder dialog, then verify it actually cleared.
#
# Never confirm blindly. The highlighted option is whichever the CLI last left
# selected, and for a directory that was previously declined it is "No, exit" -
# a bare Enter there kills the agent. So read the highlighted row, move the
# selection onto the trust option, and only confirm once it is actually there.
#
# Three dialog states matter: open (0), verified clear (1), read failed (2).
# A failed read is not evidence of clearing, so it retries and then fails closed
# rather than reporting a session that is really still trapped at the dialog.
pane_text() { herdr pane read "$pane" --source visible --lines 60 2>/dev/null; }
dialog_state() {
  local text
  text="$(pane_text)" || return 2
  grep -qiE 'Quick safety check|trust this folder|trust the contents of this directory' <<<"$text" && return 0
  return 1
}
send_key() {
  herdr pane send-keys "$pane" "$1" >/dev/null 2>&1 || {
    echo "herdr-spawn: trust-dialog keystroke failed; closing tab $tab" >&2
    close_orphan_tab; exit 69; }
}

cleared=0
for _ in $(seq 1 "${HERDR_SPAWN_TRUST_RETRIES:-12}"); do
  state=0; dialog_state || state=$?
  [[ "$state" == 1 ]] && { cleared=1; break; }
  if [[ "$state" == 0 ]]; then
    # The highlighted row is the one marked with the selection caret.
    if pane_text | grep -E '^[[:space:]]*❯' | head -1 | grep -qiE 'trust (this folder|the contents)'; then
      send_key Enter
    else
      send_key Down
    fi
  fi
  sleep 1
done
if [[ "$cleared" != 1 ]]; then
  state=0; dialog_state || state=$?
  case "$state" in
    1) : ;;
    2) echo "herdr-spawn: could not read the pane to verify the trust dialog; failing closed" >&2
       close_orphan_tab; exit 69 ;;
    *) echo "herdr-spawn: trust dialog did not clear; failing closed" >&2
       close_orphan_tab; exit 69 ;;
  esac
fi

# The dialog clearing does not mean the agent can accept a prompt yet: it may
# still be booting, and a prompt fired into that window is never reacted to -
# Herdr reports `agent_prompt_stalled` and the message is lost. Wait until the
# agent reports its own session and status before calling the spawn done.
provider_session_id=""; agent_status=""
for _ in $(seq 1 "${HERDR_SPAWN_READY_RETRIES:-20}"); do
  info="$(herdr agent get "$name" 2>/dev/null || true)"
  provider_session_id="$(jq -r '.result.agent.agent_session.value // empty' <<<"$info" 2>/dev/null || true)"
  agent_status="$(jq -r '.result.agent.agent_status // empty' <<<"$info" 2>/dev/null || true)"
  # Readiness is the reported status, not the session id: Herdr resolves a
  # provider session on some hosts and not others, but a status means the agent
  # is attached and can be prompted.
  [[ -n "$agent_status" ]] && break
  sleep 1
done
if [[ -z "$agent_status" ]]; then
  echo "herdr-spawn: agent never reported a status; it is not ready for prompts" >&2
  close_orphan_tab; exit 69
fi
[[ -n "$provider_session_id" ]] || provider_session_id="herdr:$name"

# Deliver the role contract.
#
# A Claude agent loads its contract itself, through `--agent ROLE`, which the
# caller passes. Codex has no custom-agent file, so without this the role is
# only a label and the agent runs having read the operating model but never the
# contract that bounds it. That is not a detail: a role's write surface lives in
# its contract, so an undelivered contract is an agent that does not know where
# it may write.
#
# The installed profile is the lookup, so a contract owned by any peer
# repository resolves without this script knowing which one.
contract_file="$HOME/.claude/agents/$role.md"
contract="not-found"
if [[ "$kind" == claude ]]; then
  contract="loaded-by-agent-flag"
elif [[ -f "$contract_file" ]]; then
  if herdr agent prompt "$name" "Your role contract follows. It governs this session, including where you may write. Follow it.

$(cat "$contract_file")" --wait --until working --until idle >/dev/null 2>&1; then
    contract="delivered"
  else
    contract="undelivered"
    echo "herdr-spawn: could not deliver the $role contract; the agent does not know its bounds" >&2
  fi
fi

echo "name=$name role=$role tab=$tab pane=$pane cwd=$cwd remote_control=$remote_control contract=$contract provider_session_id=$provider_session_id"
