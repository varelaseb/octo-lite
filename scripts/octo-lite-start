#!/usr/bin/env bash
# octo-lite's published start command: one orchestrator in its own Herdr tab.
# Callers use this, never herdr-spawn's path inside the clone.
set -euo pipefail

workspace=""; cwd="$PWD"; name=""; label="orchestrator"; runtime="claude"; model=()
usage() {
  echo "usage: octo-lite-start --workspace ID [--cwd DIR] [--name NAME] [--label LABEL]" \
       "[--runtime claude|codex] [--operating-model FILE]" >&2
  exit 64
}
while (($#)); do
  case "$1" in
    --workspace) workspace="${2:?}"; shift 2 ;;
    --cwd) cwd="${2:?}"; shift 2 ;;
    --name) name="${2:?}"; shift 2 ;;
    --label) label="${2:?}"; shift 2 ;;
    --runtime) runtime="${2:?}"; shift 2 ;;
    --operating-model) model=(--operating-model "${2:?}"); shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$workspace" ]] || usage
case "$runtime" in
  claude|codex) ;;
  *) usage ;;
esac
# Herdr rejects '/' and the like in agent names.
[[ -n "$name" ]] || name="orchestrator-$(basename "$(cd "$cwd" && pwd -P)" | tr -c 'A-Za-z0-9_\n-' -)"

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
exec "$root/skills/herdr-comms/assets/herdr-spawn" --workspace "$workspace" --name "$name" \
  --label "$label" --cwd "$cwd" --role orchestrator "${model[@]}" -- "$runtime"
