#!/usr/bin/env bash
set -euo pipefail

prefix=""
check=false
onboard=false
undo=false
after_pull=false
project=""
while (($#)); do
  case "$1" in
    --prefix) prefix="${2:?}"; shift 2 ;;
    --check) check=true; shift ;;
    --onboard) onboard=true; shift ;;
    --undo) undo=true; shift ;;
    --after-pull) after_pull=true; shift ;;
    --project) project="$(readlink -m "${2:?}")"; shift 2 ;;
    *) echo "usage: install-octo-lite [--prefix PATH] [--project CHECKOUT] [--check | --onboard | --after-pull | --undo]" >&2; exit 64 ;;
  esac
done

root="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# One root: --prefix owns every path it writes, state and config included;
# without it, XDG decides under $HOME. scope keeps this run's prefix and
# project for the after-pull step it publishes. Each resolves whether or not
# it exists, so --check creates neither (install.spec.html#install-check).
scope=()
if [[ -n "$prefix" ]]; then
  prefix="$(readlink -m "$prefix")"
  state_home="$prefix/.local/state"
  scope+=(--prefix "$prefix")
else
  prefix="$HOME"
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
fi
[[ -n "$project" ]] && scope+=(--project "$project")

# One pass judges each path by one rule, whatever the mode: install acts on
# the verdict, --check names it, so the two cannot disagree on a path. A
# verifying run, --check or --after-pull, names every problem it finds, one
# line each with the step that fixes it, and exits non-zero once all are named
# (install.spec.html#install-check); --after-pull installs and verifies in this
# one pass, so it names each problem once. Most are fixed by installing again
# from this clone with this run's scope.
verify=false
[[ "$check" == true || "$after_pull" == true ]] && verify=true
install_cmd="$(printf '%q ' "$root/scripts/install-octo-lite" "${scope[@]}")"
install_cmd="${install_cmd% }"
skillfile_install="curl -fsSL https://github.com/eljulians/skillfile/releases/latest/download/install.sh | sh"
problems=0
problem() { echo "$1; fix: $2" >&2; problems=$((problems + 1)); }
# act PROBLEM COMMAND...: a verdict installing fixes. Install runs COMMAND;
# --check names PROBLEM, fixed by installing.
act() {
  if [[ "$check" == true ]]; then problem "$1" "run $install_cmd"; else "${@:2}"; fi
}

# octo-lite registers herdr-wake as Spec Chat's `wake` provider (Spec Chat owns
# the format: review-service.spec.html#providers). Written only with Herdr on
# the box; install and --undo touch it only while absent or exactly ours.
# Undo leaves the wake provider in place: Spec Chat's review service depends on
# it for the box's lifetime, and removing it breaks hand-off delivery while the
# review service is still running (#430-gap6).
wake_file="$state_home/spec-chat/hosting/default/providers/wake.toml"
waker="$prefix/.local/bin/herdr-wake"
wake_toml="check = [\"$waker\", \"check\", \"{owner}\"]
send = [\"$waker\", \"send\", \"{owner}\", \"{artifact}\", \"{message}\"]"

# The command-time hook (command-time.spec.html) is registered in each agent
# CLI's hook settings, beside the operator's and other tools' entries
# (install.spec.html#install-hooks). Each CLI reads hooks only from these files,
# so here alone the installer edits a file instead of linking one. MODE install
# adds, check verifies, undo removes, only the entries running the hook's link;
# a file it cannot read as settings, or write, is left untouched and reported.
# A verifying run names each problem with its fix and fails once all are named.
# Claude's PostToolUse and PostToolUseFailure inputs carry the command's
# duration; Codex's PostToolUse does not, so its PreToolUse stamps the start.
# Claude's StopFailure, a turn any API error ended, carries the stall report
# (herdr-transport.spec.html#transport-stall-report): its matcher matches the
# error, so its entry has none; a tool event's matches shell commands.
# Codex runs a new or changed entry only once the operator trusts it there;
# nothing here records that trust.
hook_settings() {
  python3 - "$1" "$verify" "$prefix/.local/bin/octo-lite-command-time" "$install_cmd" \
    "$prefix/.claude/settings.json" PostToolUse,PostToolUseFailure,StopFailure \
    "$prefix/.codex/hooks.json" PreToolUse,PostToolUse <<'PY'
import json, os, shlex, shutil, sys

mode, verify, command, install, *files = sys.argv[1:]
command = shlex.quote(command)
failed = False


def report(problem, fix=f"run {install}"):
    global failed
    if verify == "true":
        failed = True
        problem += f"; fix: {fix}"
    print(problem, file=sys.stderr)


for path, events in zip(files[::2], files[1::2]):
    events = events.split(",")
    try:
        with open(path) as f:
            data = json.load(f)
        hooks = data.setdefault("hooks", {})
        if not all(isinstance(g["hooks"], list) for e in hooks.values() for g in e):
            raise TypeError
    except FileNotFoundError:
        hooks = {}
        data = {"hooks": hooks}
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        report(f"hook settings not readable as settings, left untouched: {path}",
               f"repair it as JSON settings, then run {install}")
        continue
    ours = lambda h: isinstance(h, dict) and h.get("command") == command
    has = lambda e: any(ours(h) for g in hooks.get(e, []) for h in g["hooks"])
    missing = [e for e in events if not has(e)]
    if mode == "check":
        if missing:
            report(f"missing command-time hook ({', '.join(missing)}): {path}")
        continue
    if mode == "install":
        for e in missing:
            entry = {"hooks": [{"type": "command", "command": command}]}
            hooks.setdefault(e, []).append({"matcher": "Bash", **entry} if "ToolUse" in e else entry)
        changed = bool(missing)
    else:
        changed = False
        for e in list(hooks):
            kept = []
            for g in hooks[e]:
                rest = [h for h in g["hooks"] if not ours(h)]
                if len(rest) < len(g["hooks"]):
                    changed = True
                    if not rest:
                        continue
                    g["hooks"] = rest
                kept.append(g)
            if kept or not hooks[e]:
                hooks[e] = kept
            else:
                del hooks[e]
        if changed and not hooks:
            del data["hooks"]
    if changed:
        real = os.path.realpath(path)
        tmp = f"{real}.octo-lite.{os.getpid()}"
        try:
            os.makedirs(os.path.dirname(real), exist_ok=True)
            with open(tmp, "w") as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
                f.write("\n")
            if os.path.exists(real):
                shutil.copymode(real, tmp)
            os.replace(tmp, real)
        except OSError:
            report(f"hook settings not writable, left untouched: {path}")
            continue
        print(f"command-time hook {'registered in' if mode == 'install' else 'removed from'}: {path}")
    if mode == "install" and path.endswith("/.codex/hooks.json"):
        print("Codex runs octo-lite's command-time hook only once you trust it in Codex"
              " (/hooks); octo-lite never records that trust for you.")
sys.exit(failed)
PY
}

# Keys (install.spec.html#install-keys): each key or account a feature of
# octo-lite needs, as NAME:FILE under the prefix's home:VARIABLE:CHECK. A new
# key is one more entry and its CHECK. --onboard asks for each once and keeps
# it; --check proves each works; --after-pull leaves keys out, since no install
# run writes one; --undo leaves each file, the box owner's, so nothing records
# what onboarding wrote.
keys=(
  "X token:.config/workbench/x.env:X_BEARER_TOKEN:x_check"
)
each_key() {
  local key name file variable key_check
  for key in "${keys[@]}"; do
    IFS=: read -r name file variable key_check <<<"$key"
    "$1" "$name" "$prefix/$file" "$variable" "$key_check"
  done
}
# A file there is adopted, never overwritten. Else the key comes from its
# variable, else from a question asked only at a terminal, so piped consent
# answers are never read as a key. Skipping writes nothing. The file, the
# box user's alone from creation, holds only VARIABLE=key; no output names
# the key.
onboard_key() {
  local key="${!3:-}"
  if [[ -e "$2" ]]; then echo "$1 adopted: $2"; return; fi
  if [[ -z "$key" && -t 0 ]]; then
    read -rs -p "$1 for $2 (Enter skips): " key || key=""
    echo >&2
  fi
  if [[ -z "$key" ]]; then echo "$1 not given, nothing written: $2"; return; fi
  (umask 077 && mkdir -p "$(dirname "$2")" && printf '%s=%s\n' "$3" "$key" >"$2")
  echo "$1 written: $2"
}
# Every reader of a key's file takes its value as this sed does, never by
# sourcing the file. --onboard writes only an absent file, so only then is it
# the fix.
check_key() {
  local key fix="put the one line $3=<$1> in $2, mode 0600"
  # The line's value, without one surrounding pair of matching quotes, as a
  # shell assignment may hold it; never sourced, so nothing in it runs.
  key="$(sed -n "/^$3=/{s///;s/^\([\"']\)\(.*\)\1\$/\2/;p;}" "$2" 2>/dev/null)" || key=""
  if [[ -n "$key" ]]; then "$4" "$1" "$2" "$key"; return; fi
  [[ -e "$2" ]] || fix+=", or run $install_cmd --onboard"
  problem "missing $1: $2" "$fix"
}
keep_key() { [[ ! -e "$2" ]] || echo "kept $1: $2 (the box owner's to delete)"; }
# The cheapest call the X token makes: one recent search for a word no post
# contains, so it reads no post against the token's cap. The token reaches
# curl on its standard input, never its command line. A 2xx proves it; a 429
# (a rate limit, or a spent monthly cap until its reset), a 5xx, or no answer
# means nothing on the box is wrong; any other answer is X refusing it. A 429
# and a refusal are named with X's own answer.
x_check() {
  local out status answer=""
  out="$(curl -s --max-time 10 -w '\n%{http_code}' -H @- \
    'https://api.x.com/2/tweets/search/recent?query=octolitekeycheck7f3a9c2e&max_results=10' \
    <<<"Authorization: Bearer $3" 2>/dev/null)" || true
  status="${out##*$'\n'}" status="${status#000}" # curl's 000: no answer
  [[ "${out%$'\n'*}" =~ \"(title|detail)\":\ ?\"([^\"]*)\" ]] && answer="${BASH_REMATCH[2]}"
  case "$status" in
    2??) echo "$1 proved by X: $2" ;;
    429) echo "$1 not proved, X answered ($status${answer:+ $answer}): $2" ;;
    ""|5??) echo "$1 not proved, X did not answer${status:+ ($status)}: $2" ;;
    *) problem "$1 refused by X ($status${answer:+ $answer}): $2" \
         "get a new token, or a plan with recent search, and put it in $2" ;;
  esac
}

if [[ "$undo" == true ]]; then
  hook_settings undo
  [[ -f "$wake_file" ]] && echo "kept wake provider: $wake_file (spec-chat depends on it)"
  each_key keep_key
  exit 0
fi

# Onboarding: octo-lite asks its own consent questions and keeps the answers
# as the [consent] table of its one onboarding file, beside the status it
# publishes for any reader. Kept answers are not asked again; delete the file
# to be asked afresh. after_pull is the argv a host runs, no shell, after
# fast-forwarding this clone; every run but --check and --undo rewrites it
# from this run's scope, and commit records this clone's commit it ran at, so
# herdr-spawn can tell the clone moved since
# (install.spec.html#install-after-pull). check is the argv a host runs, no
# shell, to learn the setup problems of the box this run set up
# (#install-setup-check); this clone's own script, so a pull changes it at once.
# operating_model, herdr-spawn's record of the box's operating model, is kept
# as found (#install-consent).
# Written before any step that can stop the run, so a failing run is recorded
# too and herdr-spawn runs it once per move. The file is rewritten in place:
# herdr-spawn holds its lock while it runs the step.
if [[ "$check" != true ]]; then
  onboarding="$state_home/octo-lite/onboarding.toml"
  consent="$(sed -n '/^\[consent\]$/,$p' "$onboarding" 2>/dev/null || true)"
  model="$(grep -m1 '^operating_model = ' "$onboarding" 2>/dev/null || true)"
  [[ -z "$model" ]] || model+=$'\n'
  if [[ "$onboard" == true && -z "$consent" ]]; then
    consent="[consent]"
    for pair in "push:push branches" "pull_request:open pull requests" "issues:file issues"; do
      read -r -p "May octo-lite agents ${pair#*:}? [y/N] " answer || answer=""
      [[ "$answer" == [yY]* ]] && value=true || value=false
      consent+=$'\n'"${pair%%:*} = $value"
    done
  fi
  status=pending
  [[ -n "$consent" ]] && status=done && consent=$'\n'"$consent"$'\n'
  argv() { local a; a="$(printf ', "%s"' "$root/scripts/install-octo-lite" "$1" "${scope[@]}")"; echo "[${a:2}]"; }
  mkdir -p "$(dirname "$onboarding")"
  commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
  printf 'status = "%s"\ndoc = "%s"\nafter_pull = %s\ncheck = %s\ncommit = "%s"\n%s%s' "$status" \
    "https://github.com/varelaseb/octo-lite/blob/main/README.md#onboarding" \
    "$(argv --after-pull)" "$(argv --check)" "$commit" "$model" "$consent" >"$onboarding"
  echo "onboarding $status: $onboarding"
  [[ "$onboard" != true ]] || each_key onboard_key
fi

# Canonical owner/repo from a git remote URL so SSH and HTTPS match:
#   git@github.com:o/r.git  ->  o/r
#   https://github.com/o/r.git  ->  o/r
normalize_origin() {
  local url="$1"
  # SSH: git@host:owner/repo(.git)
  if [[ "$url" =~ ^git@[^:]+:(.+)(\.git)?$ ]]; then
    local path="${BASH_REMATCH[1]}"
    printf '%s' "${path%.git}"
    return
  fi
  # HTTPS: https://host/owner/repo(.git)
  if [[ "$url" =~ ^https?://[^/]+/(.+)$ ]]; then
    local path="${BASH_REMATCH[1]}"
    printf '%s' "${path%.git}"
    return
  fi
  printf '%s' "$url"
}

# True when path (existing or not) lies in a clone of this repo: this one, or
# another with the same git remote origin. A missing path is judged by its
# nearest existing ancestor directory.
is_ours() {
  local dir="$1"
  while [[ ! -d "$dir" ]]; do dir="$(dirname "$dir")"; done
  local other_root
  other_root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$other_root" == "$root" ]] && return 0
  local our_origin other_origin our_key other_key
  our_origin="$(git -C "$root" remote get-url origin 2>/dev/null)" || return 1
  other_origin="$(git -C "$other_root" remote get-url origin 2>/dev/null)" || return 1
  our_key="$(normalize_origin "$our_origin")"
  other_key="$(normalize_origin "$other_origin")"
  [[ -n "$our_key" && "$our_key" == "$other_key" ]]
}

# True when an existing resolved path lives in a different clone of this repo.
# Used to adopt links from a prior octo-lite clone.
is_same_origin_clone() {
  [[ -e "$1" ]] || return 1
  [[ "$(git -C "$(dirname "$1")" rev-parse --show-toplevel 2>/dev/null)" != "$root" ]] && is_ours "$1"
}

occupant() {
  if [[ -L "$1" ]]; then echo "symlink -> $(readlink "$1")"
  elif [[ -d "$1" ]]; then echo directory
  else echo file
  fi
}

# One verdict per link the installer makes (install.spec.html#install-collision).
link_one() {
  local source="$1" target="$2"
  if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
    return 0
  elif [[ -L "$target" ]] && is_same_origin_clone "$(readlink -f "$target")"; then
    echo "adopted: $target -> $(readlink "$target")"
  elif [[ -L "$target" && ! -e "$target" ]] && is_ours "$(readlink -m "$target")"; then
    return 0 # the prune's: --check named it, install removed it before linking
  elif [[ -e "$target" || -L "$target" ]]; then
    if [[ "$verify" == true ]]; then
      problem "bad link: $target (occupied by $(occupant "$target"))" "move it aside, then run $install_cmd"
    else
      echo "skipped: $target (occupied by $(occupant "$target"))"
    fi
  else
    act "missing link: $target" make_link "$source" "$target"
  fi
}
make_link() { mkdir -p "$(dirname "$2")" && ln -s "$1" "$2"; }

# Known legacy octo-lite symlinks from earlier role/adapter names. One still
# resolving into this repo is a leftover of ours; a dangling one is the prune's
# below, which judges every dangling link by one rule. Any other file or link at
# these exact paths is left untouched.
legacy_links=(
  ".codex/octo-lite-role-skills.json"
  ".claude/agents/octo-lite-implementer.md"
  ".claude/agents/octo-lite-reviewer.md"
  ".codex/agents/octo-lite-implementer.toml"
  ".codex/agents/octo-lite-reviewer.toml"
  ".codex/agents/meta-operator.toml"
  ".codex/agents/orchestrator.toml"
  ".codex/agents/implementer.toml"
  ".codex/agents/code-reviewer.toml"
  ".codex/agents/qa-capture.toml"
  ".codex/agents/qa-reviewer.toml"
  ".codex/agents/reconciler.toml"
  ".claude/agents/qa-capture.md"
  ".claude/agents/qa-reviewer.md"
  ".claude/agents/reconciler.md"
  ".claude/agents/tdd-observer.md"
  ".codex/octo-lite/roles.toml"
  ".claude/octo-lite/roles.toml"
  ".codex/octo-lite/roles"
  ".claude/octo-lite/roles"
  ".codex/octo-lite/workflows"
  ".claude/octo-lite/workflows"
  ".claude/skills/octo-lite-loop"
  ".codex/skills/octo-lite-loop"
  ".claude/skills/octo-lite-issue-shaper"
  ".codex/skills/octo-lite-issue-shaper"
  ".claude/skills/qa-evidence-capture"
  ".codex/skills/qa-evidence-capture"
)

for legacy in "${legacy_links[@]}"; do
  target="$prefix/$legacy"
  if [[ -L "$target" && -e "$target" && "$(readlink -f "$target")" == "$root"/* ]]; then
    act "leftover legacy link: $target" rm -f "$target"
  fi
done

# A dangling link whose target was inside a clone of this repository is ours:
# install prunes it, so linking finds none, and --check names it. Any other
# dangling link is reported, not a problem, so on standard output, and left
# untouched (install.spec.html#install-check). The prune walks every directory
# the installer links into or a legacy link lies in.
prune() { rm -rf "$1"; echo "pruned: $1"; }
for d in "$prefix/.claude/skills" "$prefix/.codex/skills" "$prefix/.agents/skills" \
         "$prefix/.claude/agents" "$prefix/.codex/agents" "$prefix/.local/bin" \
         "$prefix/.claude/octo-lite" "$prefix/.codex/octo-lite" "$prefix/.codex"; do
  for f in "$d"/*; do
    [[ -L "$f" && ! -e "$f" ]] || continue
    if is_ours "$(readlink -m "$f")"; then
      act "dangling legacy link: $f" prune "$f"
    else
      echo "dangling link (not ours): $f -> $(readlink "$f")"
    fi
  done
done

# Each peer links only what it owns (ADR-004). Spec Chat's installer links its
# own skills; octo-lite does not link them.

for base in "$prefix/.codex/octo-lite" "$prefix/.claude/octo-lite"; do
  link_one "$root/agents" "$base/adapters"
done

# Stageshow is pinned in Skillfile and never committed (install.spec.html
# #install-peers): skillfile fetches it at its pin into agents/skills, which git
# ignores. It and the round video recorder (#install-recorder) get the
# dependencies their lockfiles name by npm ci, rerun only when that lockfile is
# newer than npm's record of the last install, which is also what --check takes
# as installed; each one's pinned driver then installs its Chromium, a no-op
# once there, which for Stageshow --check also takes as installed
# (#install-stageshow-browser). The recorder's lockfile sits at this clone's
# root, where Node finds its dependencies from the recorder's folder, so none
# lands in a skill folder; each run but --check removes those an earlier
# install left in the recorder's folder.
# A failed step leaves Stageshow out, leaves the recorder linked, and
# everything else still links; every mode then fails naming why, last.
# Only --check skips the fetch, so only a fetch failure is install's alone.
stageshow="$root/agents/skills/stageshow"
recorder="$root/skills/implement-spec/assets/prototype-video"
[[ "$check" == true ]] || rm -rf "$recorder/node_modules"
deps_current() {
  [[ -e "$1/node_modules/.package-lock.json" &&
     ! "$1/package-lock.json" -nt "$1/node_modules/.package-lock.json" ]]
}
npm_deps() { deps_current "$1" || (cd "$1" && npm ci --no-audit --no-fund --loglevel=error); }
# Every browser install keeps the browsers already on the box: another lane's
# agent may use one no installed driver names.
playwright_chromium() { (cd "$1" && PLAYWRIGHT_SKIP_BROWSER_GC=1 npm exec -- playwright-core install "${@:2}" chromium); }
# Each browser the driver installs for chromium, as it lists them, finished.
has_chromium() {
  local dirs dir
  dirs="$(playwright_chromium "$1" --dry-run 2>/dev/null | sed -n 's/^ *Install location: *//p')" && [[ -n "$dirs" ]] || return 1
  while IFS= read -r dir; do [[ -e "$dir/INSTALLATION_COMPLETE" ]] || return 1; done <<<"$dirs"
}
if command -v skillfile >/dev/null; then why="" stageshow_fix="run $install_cmd"
else why="skillfile not found" stageshow_fix="$skillfile_install, then run $install_cmd"
fi
# Each file of Stageshow's pin in skillfile's cache deploys with octo-lite's
# patches applied. skillfile deploys only files missing from agents/skills,
# across pin changes too, so after the fetch each deployed file of the pin that
# differs from the pin with the patches applied, all or none, is removed, and
# skillfile deploys it again, keeping the skill's dependencies. A failed fetch
# removes nothing. tdd's patched file is committed, so a pull brings it.
pinned="$root/.skillfile/cache/skills/stageshow"
patches="$root/.skillfile/patches/skills/stageshow"
redeploy_changed() {
  local want f
  want="$(mktemp -d)"
  cp -r "$pinned/." "$want"
  (cd "$want" && find "$patches" -name '*.patch' -exec git apply {} +) 2>/dev/null
  while IFS= read -r f; do cmp -s "$want/$f" "$stageshow/$f" || rm -f "$stageshow/$f"; done < <(cd "$want" && find . -type f)
  rm -r "$want"
}
if [[ "$check" != true && -z "$why" ]]; then
  if ! (cd "$root" && skillfile install -q && redeploy_changed && skillfile install -q); then
    why="skillfile install failed"
  elif ! npm_deps "$stageshow"; then why="npm ci failed"
  elif ! playwright_chromium "$stageshow"; then why="browser install failed"
  fi
  [[ -z "$why" ]] || stageshow_fix="resolve its error above, then $stageshow_fix"
fi
# skillfile records a patch that no longer applies as its conflict, and
# ignores one naming a file its pin lacks, so every mode reads both.
patch_gone() {
  local patch
  [[ -e "$root/.skillfile/conflict" ]] && return
  [[ -d "$pinned" && -d "$patches" ]] || return 1
  while IFS= read -r patch; do
    [[ -e "$pinned/${patch%.patch}" ]] || return 0
  done < <(cd "$patches" && find . -name '*.patch')
  return 1
}
if patch_gone; then
  why="octo-lite's patch no longer applies to its pin"
  stageshow_fix="pull a fixed octo-lite, run skillfile resolve --abort in $root, then run $install_cmd"
fi
[[ -n "$why" ]] || deps_current "$stageshow" || why="filming dependencies not installed"
[[ -n "$why" ]] || has_chromium "$stageshow" || why="no browser, its Chromium not installed"
recorder_why="" recorder_fix="run $install_cmd"
if [[ "$check" != true ]]; then
  if ! npm_deps "$root"; then recorder_why="npm ci failed"
  elif ! playwright_chromium "$root"; then recorder_why="browser install failed"
  fi
  [[ -z "$recorder_why" ]] || recorder_fix="resolve its error above, then $recorder_fix"
fi
[[ -n "$recorder_why" ]] || deps_current "$root" || recorder_why="browser driver not installed"

# agents/skills holds only the pins skillfile installs (install.spec.html
# #install-peers), each mirrored into every platform skills dir; octo-lite's own
# skills link from skills/ alone. An earlier install's skillfile also copied
# each own skill there and never prunes the copy, which goes stale the moment
# the source is edited: each run but --check removes it, --check names it.
managed_skills=""
if [[ -d "$root/agents/skills" ]]; then
  for source in "$root"/agents/skills/*; do
    [[ -d "$source" ]] || continue
    name="$(basename "$source")"
    if [[ -d "$root/skills/$name" ]]; then
      act "leftover copy of an own skill: $source" prune "$source"
      continue
    fi
    managed_skills+=" $name"
    link_one "$source" "$prefix/.codex/skills/$name"
    link_one "$source" "$prefix/.agents/skills/$name"
    link_one "$source" "$prefix/.claude/skills/$name"
  done
fi

for source in "$root"/skills/*; do
  [[ -d "$source" ]] || continue
  name="$(basename "$source")"
  link_one "$source" "$prefix/.codex/skills/$name"
  link_one "$source" "$prefix/.agents/skills/$name"
  link_one "$source" "$prefix/.claude/skills/$name"
done

# ADR 0002 mirror invariant: every managed skill present in agents/skills must
# resolve identically from .claude/skills and .codex/skills. link_one names a
# link missing, dangling, or someone else's; it passes one adopted from another
# clone of this repo, so two links resolving into different clones are named here.
if [[ "$verify" == true ]]; then
  for name in $managed_skills; do
    claude_skill="$prefix/.claude/skills/$name"
    codex_skill="$prefix/.codex/skills/$name"
    [[ -e "$claude_skill" && -e "$codex_skill" ]] || continue
    claude_real="$(readlink -f "$claude_skill")" codex_real="$(readlink -f "$codex_skill")"
    if [[ "$claude_real" != "$codex_real" ]] && is_ours "$claude_real" && is_ours "$codex_real"; then
      problem "managed skill mirror broken: $name" "remove $claude_skill and $codex_skill, then run $install_cmd"
    fi
  done
fi

for source in "$root"/agents/*.md; do
  name="$(basename "$source")"
  link_one "$source" "$prefix/.claude/agents/$name"
  link_one "$source" "$prefix/.codex/agents/$name"
done

for source in "$root"/scripts/*; do
  [[ -x "$source" && -f "$source" ]] || continue
  link_one "$source" "$prefix/.local/bin/$(basename "$source")"
done
for source in "$root"/skills/herdr-comms/assets/* "$recorder/prototype-video"; do
  [[ -x "$source" ]] || continue
  link_one "$source" "$prefix/.local/bin/$(basename "$source")"
done

# Project skills: the target's AGENTS.md declares them on one line,
# `Repo skills: a/skill, b/skill`, and they link from the given live main
# checkout only. An existing link resolving anywhere else is stale: warn,
# leave it, continue; a verifying run names it as a problem. Never repair it,
# never link from another clone. An AGENTS.md it cannot read, the checkout gone
# or without one, is one problem, and the run goes on.
if [[ -n "$project" ]]; then
  repo_skills="$(sed -n '/^[-*[:space:]]*Repo skills:/{s///p;q;}' "$project/AGENTS.md" 2>/dev/null)" ||
    problem "project AGENTS.md not readable: $project/AGENTS.md" \
      "run ${install_cmd% --project *} --project <the project's live main checkout>"
  while read -r rel; do
    [[ -n "$rel" ]] || continue
    source="$project/$rel"
    [[ -e "$source" ]] || {
      problem "missing source: $source" "correct its path on the Repo skills line of $project/AGENTS.md, then run $install_cmd"
      continue; }
    for dir in .codex/skills .agents/skills .claude/skills; do
      target="$prefix/$dir/$(basename "$rel")"
      if [[ -L "$target" && "$(readlink -f "$target")" != "$(readlink -f "$source")" ]]; then
        stale="stale link: $target -> $(readlink "$target") (not from $project)"
        if [[ "$verify" == true ]]; then problem "$stale" "move it aside, then run $install_cmd"
        else echo "$stale" >&2
        fi
        continue
      fi
      link_one "$source" "$target"
    done
  done <<< "${repo_skills//,/$'\n'}"
fi

# Version floors (install.spec.html#install-floors): each tool octo-lite uses
# at runtime, with the minimum version it needs and where to get it. A
# verifying run prints each version found that meets its floor, and names each
# tool missing or too old as a problem, fixed by getting it from its source.
floor_tools=(
  "git:2.25.0:https://git-scm.com/downloads"
  "herdr:0.1.0:https://github.com/herdrdev/herdr"
  "jq:1.6:https://jqlang.github.io/jq/download/"
  "gh:2.0.0:https://cli.github.com/"
  "claude:1.0.0:https://docs.anthropic.com/en/docs/claude-code"
  "codex:0.1.0:https://openai.com/index/introducing-codex/"
  "node:22.0.0:https://nodejs.org/en/download"
  "python3:3.12.0:https://www.python.org/downloads/"
)

version_of() {
  local cmd="$1"
  case "$cmd" in
    git) git --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    herdr) herdr --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    jq) jq --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    gh) gh --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    claude) claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    node) node --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    python3) python3 --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    codex) codex --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
  esac
}

# Compare two dotted version strings: 0 if a>=b, 1 if a<b.
version_ge() {
  local a="$1" b="$2"
  [[ "$a" == "$b" ]] && return 0
  local IFS='.'; local -a va=($a) vb=($b)
  local i max=$(( ${#va[@]} > ${#vb[@]} ? ${#va[@]} : ${#vb[@]} ))
  for (( i=0; i<max; i++ )); do
    local na="${va[i]:-0}" nb="${vb[i]:-0}"
    (( na > nb )) && return 0
    (( na < nb )) && return 1
  done
  return 0
}

check_floors() {
  local entry cmd min_ver source found agents=""
  for entry in "${floor_tools[@]}"; do
    IFS=: read -r cmd min_ver source <<< "$entry"
    if ! command -v "$cmd" >/dev/null 2>&1; then
      # claude and codex: one is enough; both missing is one problem, below
      if [[ "$cmd" == claude || "$cmd" == codex ]]; then agents+="${agents:+ or }$cmd >= $min_ver from $source"
      else problem "$cmd missing (need >= $min_ver)" "get it from $source"
      fi
      continue
    fi
    # A tool that prints no version fails its pipeline; it is installed all the same.
    found="$(version_of "$cmd")" || found=""
    if [[ -z "$found" ]]; then
      echo "  $cmd: installed (version unknown, need >= $min_ver)"
      continue
    fi
    if version_ge "$found" "$min_ver"; then
      echo "  $cmd: ok ($found)"
    else
      problem "$cmd too old ($found < $min_ver)" "get it from $source"
    fi
  done
  [[ "$agents" != *" or "* ]] || problem "agent CLI missing (need claude or codex)" "get $agents"
}

if [[ "$check" == true ]]; then
  hook_settings check || problems=$((problems + 1))
  echo "octo-lite links checked at $prefix"
else
  hook_settings install || problems=$((problems + 1))
  echo "octo-lite links installed at $prefix"
  if [[ -e "$wake_file" && "$(cat "$wake_file")" != "$wake_toml" ]]; then
    echo "keeping foreign wake provider: $wake_file" >&2
  elif command -v herdr >/dev/null; then
    mkdir -p "$(dirname "$wake_file")"
    printf '%s\n' "$wake_toml" >"$wake_file.tmp.$$"
    mv -f "$wake_file.tmp.$$" "$wake_file"
    echo "wake provider registered: $wake_file"
  fi
fi
if [[ "$verify" == true ]]; then
  echo "version floors:"
  check_floors
fi
[[ "$check" != true ]] || each_key check_key
# Last, so it is the line an operator sees: a pinned skill or the recorder not
# installed fails every mode alike (install.spec.html#install-peers,
# #install-recorder). Any problem this run named fails it.
[[ -z "$recorder_why" ]] || problem "prototype-video not installed: $recorder_why" "$recorder_fix"
[[ -z "$why" ]] || problem "Stageshow not installed: $why" "$stageshow_fix"
exit $((problems > 0))
