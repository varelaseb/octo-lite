#!/usr/bin/env bash
set -euo pipefail

prefix="$HOME"
check=false
while (($#)); do
  case "$1" in
    --prefix) prefix="${2:?}"; shift 2 ;;
    --check) check=true; shift ;;
    *) echo "usage: install-octo-lite [--prefix PATH] [--check]" >&2; exit 64 ;;
  esac
done

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
prefix="$(mkdir -p "$prefix" && cd "$prefix" && pwd -P)"

# True when the path is already owned by some other repo installing into the
# same profile. annotateanything carries its own copy of several of these
# skills and of the operating-model file; on a box with both, one of them has
# to yield, and octo-lite is the one that yields.
owned_elsewhere() {
  local target="$1" current
  [[ -e "$target" || -L "$target" ]] || return 1
  [[ -L "$target" && ! -e "$target" ]] && return 1   # dangling is ours to clean
  current="$(readlink -f "$target" 2>/dev/null || true)"
  [[ -z "$current" ]] && return 1
  case "$current" in "$root"/*) return 1 ;; *) return 0 ;; esac
}

link_one() {
  local source="$1" target="$2"
  [[ -e "$source" || -L "$source" ]] || { echo "missing source: $source" >&2; exit 66; }
  if owned_elsewhere "$target"; then
    echo "owned by another repo, leaving it: $target -> $(readlink -f "$target")"
    return
  fi
  if [[ "$check" == true ]]; then
    [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]] || {
      echo "bad link: $target" >&2
      exit 1
    }
    return
  fi
  mkdir -p "$(dirname "$target")"
  if [[ -e "$target" || -L "$target" ]]; then
    [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]] && return
    echo "refusing to replace: $target" >&2
    exit 1
  fi
  ln -s "$source" "$target"
}

# Known legacy octo-lite symlinks from earlier role/adapter names. Migration removes
# only a dangling link or one that still resolves inside this source repo; any other
# file or link at these exact paths is left untouched. --check rejects a leftover.
legacy_links=(
  ".codex/octo-lite-role-skills.json"
  ".claude/agents/octo-lite-implementer.md"
  ".claude/agents/octo-lite-reviewer.md"
  ".codex/agents/octo-lite-implementer.toml"
  ".codex/agents/octo-lite-reviewer.toml"
  ".codex/agents/meta-operator.toml"
  ".codex/agents/orchestrator.toml"
  ".codex/agents/shaping-reviewer.toml"
  ".codex/agents/implementer.toml"
  ".codex/agents/code-reviewer.toml"
  ".codex/agents/qa-capture.toml"
  ".codex/agents/qa-reviewer.toml"
  ".codex/agents/reconciler.toml"
  ".claude/agents/shaping-reviewer.md"
  ".claude/agents/qa-capture.md"
  ".claude/agents/qa-reviewer.md"
  ".claude/agents/reconciler.md"
  ".claude/agents/tdd-observer.md"
  ".codex/octo-lite/roles.toml"
  ".claude/octo-lite/roles.toml"
  ".codex/octo-lite/roles"
  ".claude/octo-lite/roles"
  ".codex/octo-lite/workflows"
  ".claude/octo-lite/workflows"
  ".claude/skills/octo-lite-loop"
  ".codex/skills/octo-lite-loop"
  ".claude/skills/octo-lite-issue-shaper"
  ".codex/skills/octo-lite-issue-shaper"
  ".claude/skills/qa-evidence-capture"
  ".codex/skills/qa-evidence-capture"
)

migrate_legacy_link() {
  local target="$prefix/$1"
  [[ -L "$target" ]] || return 0
  if [[ -e "$target" ]]; then
    case "$(readlink -f "$target")" in
      "$root"/*) ;;
      *) return 0 ;;
    esac
  fi
  rm -f "$target"
}

check_legacy_gone() {
  local target="$prefix/$1"
  [[ -e "$target" || -L "$target" ]] || return 0
  # A path octo-lite retired may be legitimately owned by another repo that
  # installs into the same profile (annotateanything owns shaping-reviewer, for
  # example). Only a dangling link, or one still resolving into this repo, is a
  # leftover of ours. This mirrors migrate_legacy_link, which already declines
  # to remove a link belonging to someone else.
  if [[ -L "$target" && ! -e "$target" ]]; then
    echo "leftover legacy link (dangling): $target" >&2
    exit 1
  fi
  case "$(readlink -f "$target")" in
    "$root"/*)
      echo "leftover legacy link: $target" >&2
      exit 1 ;;
  esac
}

for legacy in "${legacy_links[@]}"; do
  if [[ "$check" == true ]]; then
    check_legacy_gone "$legacy"
  else
    migrate_legacy_link "$legacy"
  fi
done

# The global operating-model file is a single path that only one repo can own.
# annotateanything installs its own AGENTS.md there and is the owner going
# forward, so octo-lite yields rather than fighting over it: it installs its
# profile only when nobody else has claimed the path.
# A skill deleted from any peer repository leaves a dangling link behind, which
# no installer would otherwise heal: the owner stops creating it and everyone
# else yields to it. A broken link is nobody's, so prune it. Whichever peer
# still owns that name recreates it on its own install.
prune_dangling_skills() {
  local d f pruned=0
  for d in "$prefix/.claude/skills" "$prefix/.codex/skills"; do
    [[ -d "$d" ]] || continue
    for f in "$d"/*; do
      [[ -L "$f" && ! -e "$f" ]] || continue
      if [[ "$check" == true ]]; then
        echo "dangling skill link: $f" >&2; exit 1
      fi
      rm -f "$f"; pruned=$((pruned + 1))
    done
  done
  (( pruned )) && echo "pruned $pruned dangling skill link(s)"
  return 0
}
prune_dangling_skills

# spec-chat is a peer repository, not a vendored dependency. Its skills link
# straight from a clone, so a pull there is live and there is no pin to bump.
# Override the location with SPEC_CHAT_ROOT.
spec_chat_root="${SPEC_CHAT_ROOT:-/root/spec-chat}"
if [[ -d "$spec_chat_root/skill" ]]; then
  for pair in "shape-spec:spec-chat-shape" "review-spec:spec-chat-review"; do
    src="$spec_chat_root/skill/${pair%%:*}"; name="${pair##*:}"
    [[ -d "$src" ]] || continue
    link_one "$src" "$prefix/.claude/skills/$name"
    link_one "$src" "$prefix/.codex/skills/$name"
  done
elif [[ "$check" != true ]]; then
  echo "spec-chat clone not found at $spec_chat_root; its skills are not installed" >&2
fi

link_one "$root/profile/AGENTS.md" "$prefix/.codex/AGENTS.md"
link_one "$root/profile/AGENTS.md" "$prefix/.claude/CLAUDE.md"
for base in "$prefix/.codex/octo-lite" "$prefix/.claude/octo-lite"; do
  link_one "$root/agents" "$base/adapters"
done

# Managed skills live in the skillfile install target agents/skills (ADR 0002).
# They mirror into every platform skills dir. Locally authored skills/ skills
# that a managed entry does not shadow install alongside them.
managed_skills=""
if [[ -d "$root/agents/skills" ]]; then
  for source in "$root"/agents/skills/*; do
    [[ -d "$source" ]] || continue
    name="$(basename "$source")"
    managed_skills+=" $name"
    link_one "$source" "$prefix/.codex/skills/$name"
    link_one "$source" "$prefix/.agents/skills/$name"
    link_one "$source" "$prefix/.claude/skills/$name"
  done
fi

for source in "$root"/skills/*; do
  [[ -d "$source" ]] || continue
  name="$(basename "$source")"
  [[ " $managed_skills " == *" $name "* ]] && continue
  link_one "$source" "$prefix/.codex/skills/$name"
  link_one "$source" "$prefix/.agents/skills/$name"
  link_one "$source" "$prefix/.claude/skills/$name"
done

# ADR 0002 mirror invariant: every managed skill present in agents/skills must
# resolve identically from .claude/skills and .codex/skills.
if [[ "$check" == true ]]; then
  for name in $managed_skills; do
    claude_skill="$prefix/.claude/skills/$name"
    codex_skill="$prefix/.codex/skills/$name"
    [[ -e "$claude_skill" && -e "$codex_skill" &&
       "$(readlink -f "$claude_skill")" == "$(readlink -f "$codex_skill")" ]] || {
      echo "managed skill mirror broken: $name" >&2
      exit 1
    }
  done
fi

for source in "$root"/agents/*.md; do
  name="$(basename "$source")"
  link_one "$source" "$prefix/.claude/agents/$name"
done

for source in "$root"/scripts/*; do
  [[ -x "$source" && -f "$source" ]] || continue
  link_one "$source" "$prefix/.local/bin/$(basename "$source")"
done
for source in "$root"/skills/herdr-comms/assets/*; do
  [[ -x "$source" ]] || continue
  link_one "$source" "$prefix/.local/bin/$(basename "$source")"
done

echo "octo-lite links ${check:+checked} at $prefix"
