#!/usr/bin/env bash
set -euo pipefail

prefix=""
check=false
onboard=false
undo=false
while (($#)); do
  case "$1" in
    --prefix) prefix="${2:?}"; shift 2 ;;
    --check) check=true; shift ;;
    --onboard) onboard=true; shift ;;
    --undo) undo=true; shift ;;
    *) echo "usage: install-octo-lite [--prefix PATH] [--check | --onboard | --undo]" >&2; exit 64 ;;
  esac
done

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# One root: --prefix owns every path it writes, state and config included;
# without it, XDG decides under $HOME.
if [[ -n "$prefix" ]]; then
  prefix="$(mkdir -p "$prefix" && cd "$prefix" && pwd -P)"
  state_home="$prefix/.local/state" config_home="$prefix/.config"
else
  prefix="$HOME"
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}" config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
fi

# octo-lite registers herdr-wake as Spec Chat's `wake` provider (Spec Chat owns
# the format: review-service.spec.html#providers). Written only with Herdr on
# the box; install and --undo touch it only while absent or exactly ours.
wake_file="$state_home/spec-chat/hosting/default/providers/wake.toml"
waker="$prefix/.local/bin/herdr-wake"
wake_toml="check = [\"$waker\", \"check\", \"{owner}\"]
send = [\"$waker\", \"send\", \"{owner}\", \"{artifact}\", \"{message}\"]"
if [[ "$undo" == true ]]; then
  [[ -f "$wake_file" && "$(cat "$wake_file")" == "$wake_toml" ]] && rm -f "$wake_file" && echo "removed $wake_file"
  exit 0
fi

link_one() {
  local source="$1" target="$2"
  [[ -e "$source" || -L "$source" ]] || { echo "missing source: $source" >&2; exit 66; }
  if [[ "$check" == true ]]; then
    [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]] || {
      echo "bad link: $target" >&2
      exit 1
    }
    return
  fi
  mkdir -p "$(dirname "$target")"
  # A dangling link belongs to nobody: whoever owned it stopped shipping it.
  # Replacing it is not clobbering, and refusing to wedges the whole install
  # over a path no repo claims any more.
  [[ -L "$target" && ! -e "$target" ]] && rm -f "$target"
  if [[ -e "$target" || -L "$target" ]]; then
    [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]] && return
    echo "refusing to replace: $target" >&2
    exit 1
  fi
  ln -s "$source" "$target"
}

# Known legacy octo-lite symlinks from earlier role/adapter names. Migration removes
# only a dangling link or one that still resolves inside this source repo; any other
# file or link at these exact paths is left untouched. --check rejects a leftover.
legacy_links=(
  ".codex/octo-lite-role-skills.json"
  ".claude/agents/octo-lite-implementer.md"
  ".claude/agents/octo-lite-reviewer.md"
  ".codex/agents/octo-lite-implementer.toml"
  ".codex/agents/octo-lite-reviewer.toml"
  ".codex/agents/meta-operator.toml"
  ".codex/agents/orchestrator.toml"
  ".codex/agents/implementer.toml"
  ".codex/agents/code-reviewer.toml"
  ".codex/agents/qa-capture.toml"
  ".codex/agents/qa-reviewer.toml"
  ".codex/agents/reconciler.toml"
  ".claude/agents/qa-capture.md"
  ".claude/agents/qa-reviewer.md"
  ".claude/agents/reconciler.md"
  ".claude/agents/tdd-observer.md"
  ".codex/octo-lite/roles.toml"
  ".claude/octo-lite/roles.toml"
  ".codex/octo-lite/roles"
  ".claude/octo-lite/roles"
  ".codex/octo-lite/workflows"
  ".claude/octo-lite/workflows"
  ".claude/skills/octo-lite-loop"
  ".codex/skills/octo-lite-loop"
  ".claude/skills/octo-lite-issue-shaper"
  ".codex/skills/octo-lite-issue-shaper"
  ".claude/skills/qa-evidence-capture"
  ".codex/skills/qa-evidence-capture"
)

migrate_legacy_link() {
  local target="$prefix/$1"
  [[ -L "$target" ]] || return 0
  if [[ -e "$target" ]]; then
    case "$(readlink -f "$target")" in
      "$root"/*) ;;
      *) return 0 ;;
    esac
  fi
  rm -f "$target"
}

check_legacy_gone() {
  local target="$prefix/$1"
  [[ -e "$target" || -L "$target" ]] || return 0
  # Only a dangling link, or one still resolving into this repo, is a leftover
  # of ours. This mirrors migrate_legacy_link.
  if [[ -L "$target" && ! -e "$target" ]]; then
    echo "leftover legacy link (dangling): $target" >&2
    exit 1
  fi
  case "$(readlink -f "$target")" in
    "$root"/*)
      echo "leftover legacy link: $target" >&2
      exit 1 ;;
  esac
}

for legacy in "${legacy_links[@]}"; do
  if [[ "$check" == true ]]; then
    check_legacy_gone "$legacy"
  else
    migrate_legacy_link "$legacy"
  fi
done

# A dangling link whose target was inside this repository is a known legacy
# path: prune it. Any other dangling link is reported and left untouched.
prune_dangling_skills() {
  local d f target pruned=0
  for d in "$prefix/.claude/skills" "$prefix/.codex/skills" \
           "$prefix/.claude/agents" "$prefix/.codex/agents" "$prefix/.local/bin"; do
    [[ -d "$d" ]] || continue
    for f in "$d"/*; do
      [[ -L "$f" && ! -e "$f" ]] || continue
      target="$(readlink "$f")"
      case "$target" in
        "$root"/*) ;;
        *) echo "dangling link (not ours): $f -> $target" >&2; continue ;;
      esac
      if [[ "$check" == true ]]; then
        echo "dangling legacy link: $f" >&2; exit 1
      fi
      rm -f "$f"; pruned=$((pruned + 1))
    done
  done
  (( pruned )) && echo "pruned $pruned dangling legacy link(s)"
  return 0
}
prune_dangling_skills

# Each peer links only what it owns (ADR-004). Spec Chat's installer links its
# own skills; octo-lite does not link them.

for base in "$prefix/.codex/octo-lite" "$prefix/.claude/octo-lite"; do
  link_one "$root/agents" "$base/adapters"
done

# Managed skills live in the skillfile install target agents/skills (ADR 0002).
# They mirror into every platform skills dir. Locally authored skills/ skills
# that a managed entry does not shadow install alongside them.
#
# skillfile also materializes this repo's OWN skills into agents/skills, and
# that copy goes stale the moment the source is edited. So a materialized entry
# that shadows a directory in skills/ is skipped: the live source wins, and only
# genuinely upstream pins are linked from agents/skills.
managed_skills=""
if [[ -d "$root/agents/skills" ]]; then
  for source in "$root"/agents/skills/*; do
    [[ -d "$source" ]] || continue
    name="$(basename "$source")"
    [[ -d "$root/skills/$name" ]] && continue
    managed_skills+=" $name"
    link_one "$source" "$prefix/.codex/skills/$name"
    link_one "$source" "$prefix/.agents/skills/$name"
    link_one "$source" "$prefix/.claude/skills/$name"
  done
fi

for source in "$root"/skills/*; do
  [[ -d "$source" ]] || continue
  name="$(basename "$source")"
  [[ " $managed_skills " == *" $name "* ]] && continue
  link_one "$source" "$prefix/.codex/skills/$name"
  link_one "$source" "$prefix/.agents/skills/$name"
  link_one "$source" "$prefix/.claude/skills/$name"
done

# ADR 0002 mirror invariant: every managed skill present in agents/skills must
# resolve identically from .claude/skills and .codex/skills.
if [[ "$check" == true ]]; then
  for name in $managed_skills; do
    claude_skill="$prefix/.claude/skills/$name"
    codex_skill="$prefix/.codex/skills/$name"
    [[ -e "$claude_skill" && -e "$codex_skill" &&
       "$(readlink -f "$claude_skill")" == "$(readlink -f "$codex_skill")" ]] || {
      echo "managed skill mirror broken: $name" >&2
      exit 1
    }
  done
fi

for source in "$root"/agents/*.md; do
  name="$(basename "$source")"
  link_one "$source" "$prefix/.claude/agents/$name"
  link_one "$source" "$prefix/.codex/agents/$name"
done

for source in "$root"/scripts/*; do
  [[ -x "$source" && -f "$source" ]] || continue
  link_one "$source" "$prefix/.local/bin/$(basename "$source")"
done
for source in "$root"/skills/herdr-comms/assets/*; do
  [[ -x "$source" ]] || continue
  link_one "$source" "$prefix/.local/bin/$(basename "$source")"
done

# Version floors: each tool octo-lite uses at runtime, with the minimum version
# it needs and the upgrade source. --check reports each as ok, missing, or too
# old (found vs needed). Install mode prints them as advisory; --check treats
# missing or too old as a non-zero exit only when it is the tool that the
# installer itself needs (herdr for wake, git for links).
floor_tools=(
  "git:2.25.0:https://git-scm.com/downloads"
  "herdr:0.1.0:herdr is installed by the fleet operator"
  "jq:1.6:https://jqlang.github.io/jq/download/"
  "gh:2.0.0:https://cli.github.com/"
  "claude:1.0.0:https://docs.anthropic.com/en/docs/claude-code"
  "codex:0.1.0:https://openai.com/index/introducing-codex/"
)

version_of() {
  local cmd="$1"
  case "$cmd" in
    git) git --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    herdr) herdr --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    jq) jq --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    gh) gh --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    claude) claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
    codex) codex --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 ;;
  esac
}

# Compare two dotted version strings: 0 if a>=b, 1 if a<b.
version_ge() {
  local a="$1" b="$2"
  [[ "$a" == "$b" ]] && return 0
  local IFS='.'; local -a va=($a) vb=($b)
  local i max=$(( ${#va[@]} > ${#vb[@]} ? ${#va[@]} : ${#vb[@]} ))
  for (( i=0; i<max; i++ )); do
    local na="${va[i]:-0}" nb="${vb[i]:-0}"
    (( na > nb )) && return 0
    (( na < nb )) && return 1
  done
  return 0
}

check_floors() {
  local entry cmd min_ver source found agent_ok=false
  for entry in "${floor_tools[@]}"; do
    IFS=: read -r cmd min_ver source <<< "$entry"
    if ! command -v "$cmd" >/dev/null 2>&1; then
      # claude and codex: at least one must be present
      [[ "$cmd" == claude || "$cmd" == codex ]] && continue
      echo "  $cmd: missing (need >= $min_ver; $source)" >&2
      continue
    fi
    found="$(version_of "$cmd")"
    if [[ -z "$found" ]]; then
      echo "  $cmd: installed (version unknown, need >= $min_ver)"
      [[ "$cmd" == claude || "$cmd" == codex ]] && agent_ok=true
      continue
    fi
    if version_ge "$found" "$min_ver"; then
      echo "  $cmd: ok ($found)"
      [[ "$cmd" == claude || "$cmd" == codex ]] && agent_ok=true
    else
      echo "  $cmd: too old ($found < $min_ver; $source)" >&2
    fi
  done
  if ! $agent_ok; then
    echo "  agent CLI: missing (need claude >= 1.0.0 or codex >= 0.1.0)" >&2
  fi
}

if [[ "$check" == true ]]; then
  echo "octo-lite links checked at $prefix"
  echo "version floors:"
  check_floors
  exit 0
fi

echo "octo-lite links installed at $prefix"

if [[ -e "$wake_file" && "$(cat "$wake_file")" != "$wake_toml" ]]; then
  echo "keeping foreign wake provider: $wake_file" >&2
elif command -v herdr >/dev/null; then
  mkdir -p "$(dirname "$wake_file")"
  printf '%s\n' "$wake_toml" >"$wake_file.tmp.$$"
  mv -f "$wake_file.tmp.$$" "$wake_file"
  echo "wake provider registered: $wake_file"
fi

# Onboarding: octo-lite asks its own consent questions and keeps the answers,
# then publishes its status in its own state for any reader. Answers already
# kept are not asked again; delete the file to be asked afresh.
consent="$config_home/octo-lite/consent.toml"
if [[ "$onboard" == true && ! -e "$consent" ]]; then
  body=""
  for pair in "push:push branches" "pull_request:open pull requests" "issues:file issues"; do
    read -r -p "May octo-lite agents ${pair#*:}? [y/N] " answer || answer=""
    [[ "$answer" == [yY]* ]] && value=true || value=false
    body+="${pair%%:*} = $value"$'\n'
  done
  mkdir -p "$(dirname "$consent")"
  printf '%s' "$body" >"$consent"
  echo "consent kept at $consent"
fi
status=pending
[[ -e "$consent" ]] && status=done
state="$state_home/octo-lite"
mkdir -p "$state"
printf 'status = "%s"\ndoc = "%s"\n' "$status" \
  "https://github.com/varelaseb/octo-lite/blob/main/README.md#onboarding" >"$state/onboarding.toml"
echo "onboarding $status: $state/onboarding.toml"
