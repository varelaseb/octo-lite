#!/usr/bin/env python3
"""octo-lite's command-time hook (spec/domains/command-time.spec.html).

Claude Code and Codex run it on their tool hooks for each shell command
(matcher Bash). After a command it adds one line to the agent's context: how
long the command took, a box lock wait told apart, and a slow iteration loop
warning. It only informs (#inform-only): it never blocks, denies, or changes a
command, and on any failure it prints nothing and exits 0.

Claude's PostToolUse and PostToolUseFailure inputs carry duration_ms. Codex's
PostToolUse input has none, so its PreToolUse stamps the start by tool_use_id.
Records live in octo-lite's state directory, one file per agent session;
a new session drops every record older than a week but a disk level's mark,
which lasts until the disk is under 80% full.

After each command it also reads how full the box's disk is, and warns the
session's operator, or with none the agent, as the levels fill
(spec/domains/disk.spec.html#warning).
"""

import hashlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

SLOW = 60  # seconds of a command's own run (#loop-slow)
# A box lock wait, reported on a line of its own (#time-lock).
WAIT = re.compile(r"^flock: getting lock took ([0-9.]+) seconds$", re.M)
AGE = 7 * 86400  # seconds a record is kept
# Codex 0.166's exec output while the command runs past its yield.
RUNNING = re.compile(r"^Process running with session ID \d+$", re.M)
HERE = Path(__file__).resolve().parent
# Disk levels, each told once per session until the disk is under REARM
# (disk.spec.html#warning-levels); a level's mark is a file in the record
# store, one per Herdr session, made by one atomic create so one agent tells it.
LEVELS, REARM = (85, 90), 80
TAIL = "Nothing was removed; each lane frees only what it made."


def records() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    path = Path(state) / "octo-lite/command-time"
    path.mkdir(parents=True, exist_ok=True)
    return path


def name(text: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "_", text)


def span(seconds: float) -> str:
    if seconds < SLOW:
        return f"{seconds:.1f}s"
    minutes, secs = divmod(round(seconds), 60)
    if minutes < 60:
        return f"{minutes}m {secs:02d}s"
    return f"{minutes // 60}h {minutes % 60:02d}m"


def git(cwd: str, *args: str, check: bool = True) -> str:
    # No optional locks: git status never rewrites the agent's index (#inform-only).
    return subprocess.run(["git", "--no-optional-locks", "-C", cwd, *args],
                          capture_output=True, text=True, check=check).stdout


def running(response: object) -> bool:
    """The command still runs when its call returns: Claude moved it to the
    background, or Codex's exec outlived its yield (#time-line)."""
    if isinstance(response, dict):
        return bool(response.get("backgroundTaskId"))
    return isinstance(response, str) and bool(RUNNING.search(response))


def change_mark(cwd: str) -> str | None:
    """What a file change in the command's repository changes, or None
    outside a repository: HEAD, plus each changed or untracked path with its
    modification time, so editing an already-changed file shows too."""
    try:
        top = git(cwd, "rev-parse", "--show-toplevel").strip()
        status = git(top, "status", "--porcelain", "-z", "--untracked-files=all")
    except (OSError, subprocess.CalledProcessError):
        return None
    head = git(top, "rev-parse", "-q", "--verify", "HEAD", check=False)
    mark = [top, head]
    tokens = iter(status.split("\0"))
    for token in tokens:
        if not token:
            continue
        if token[0] in "RC":
            next(tokens, None)  # a rename's or copy's source path
        path = Path(top, token[3:])
        mark.append(f"{token}:{path.stat().st_mtime_ns if path.exists() else '-'}")
    return hashlib.sha256("\0".join(mark).encode()).hexdigest()


def output(event: dict) -> str:
    """The command's own output: Claude's stdout and stderr, Codex's text,
    a failure's error, each starting a line."""
    response = event.get("tool_response")
    parts = [*(response.values() if isinstance(response, dict) else [response]), event.get("error")]
    return "\n".join(part for part in parts if isinstance(part, str))


def post(event: dict, command: str, store: Path) -> str | None:
    stamp = store / f"{name(event.get('tool_use_id', ''))}.start"
    if event.get("duration_ms") is not None:
        took = event["duration_ms"] / 1000
    elif stamp.exists():
        took = time.time() - float(stamp.read_text())
    else:
        return None
    stamp.unlink(missing_ok=True)

    waits = WAIT.findall(output(event))
    if waits:
        waited = sum(map(float, waits))
        run = max(took - waited, 0.0)
        line = f"waited {span(waited)} for the box lock, then ran {span(run)}."
    else:
        run = took
        line = f"took {span(took)}."
    line = "octo-lite: this command " + line

    session = store / f"{name(event.get('session_id', ''))}.json"
    if session.exists():
        seen = json.loads(session.read_text())
    else:
        seen = {}
        for record in store.iterdir():
            if record.suffix != ".told" and record.stat().st_mtime < time.time() - AGE:
                record.unlink()
    key = command.strip()
    last = seen.get(key, {"runs": 0, "total": 0.0, "mark": None})
    # A fast rerun of a once-slow command marks too: a change counts from its last run.
    mark = change_mark(event.get("cwd") or ".") if run >= SLOW or last["mark"] else None
    now = {"runs": last["runs"] + 1, "total": last["total"] + took, "mark": mark}
    if run >= SLOW and mark and last["mark"] and mark != last["mark"]:
        line += (f" Slow iteration loop: you have run this command {now['runs']} times"
                 f" this session, {span(now['total'])} in all."
                 " Run only the tests for what you touched,"
                 " and the full suite once, on the final head.")
    seen[key] = now
    tmp = session.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(seen))
    tmp.replace(session)
    return line


def size(kib: float) -> str:
    for unit in ("KiB", "MiB", "GiB"):
        if kib < 1024:
            return f"{kib:.1f} {unit}"
        kib /= 1024
    return f"{kib:.1f} TiB"


def first(mark: Path) -> bool:
    """True for the one caller that makes mark."""
    try:
        os.close(os.open(mark, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
        return True
    except FileExistsError:
        return False


def disk(store: Path) -> str | None:
    """The root filesystem's fullness as df's Use% shows it, rounded up, told
    the first time it reaches a level: to the operator by a detached sender,
    else returned for the agent's line. Only a new mark starts a process."""
    st = os.statvfs("/")
    used, free = (st.f_blocks - st.f_bfree) * st.f_frsize, st.f_bavail * st.f_frsize
    full = -(-used * 100 // (used + free))
    if REARM <= full < LEVELS[0]:
        return None
    session = name(os.environ.get("HERDR_SESSION") or "default")
    marks = [store / f"disk-{level}.{session}.told" for level in LEVELS]
    if full < REARM:
        for mark in marks:
            mark.unlink(missing_ok=True)
        return None
    if not [mark for level, mark in zip(LEVELS, marks) if full >= level and first(mark)]:
        return None
    warning = f"octo-lite disk warning: the box's disk is {full}% full, {size(free / 1024)} free."
    state = subprocess.run([HERE / "octo-lite-state"], capture_output=True, text=True, check=True).stdout
    operator = Path(state.strip()) / "operator.toml"
    if not operator.exists():
        return f"{warning} {TAIL}"
    import tomllib  # only here: its import costs every command ~15ms
    pane = tomllib.loads(operator.read_text())["pane"]
    subprocess.Popen([sys.executable, __file__, "--disk-warning", pane, warning], start_new_session=True,
                     cwd="/", stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return None


def tell_operator(pane: str, warning: str) -> None:
    """Detached from the hook: name the folders holding the most of the disk,
    the most specific of du's largest, then send the warning by herdr-say."""
    du = subprocess.run(["nice", "du", "-xk", "-d", "4", "/"], capture_output=True, text=True).stdout
    sizes = {}
    for line in du.splitlines():
        kib, _, path = line.partition("\t")
        if kib.isdigit() and path not in ("", "/"):
            sizes[path] = int(kib)
    top = sorted(sizes, key=sizes.get, reverse=True)[:12]
    held = [path for path in top if not any(other.startswith(path + "/") for other in top)]
    folders = ", ".join(f"{path} {size(sizes[path])}" for path in held)
    message = f"{warning} Folders holding the most: {folders}. {TAIL}" if held else f"{warning} {TAIL}"
    subprocess.run([HERE.parent / "skills/herdr-comms/assets/herdr-say", pane, message],
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main() -> None:
    if sys.argv[1:2] == ["--disk-warning"]:
        tell_operator(*sys.argv[2:4])
        return
    event = json.load(sys.stdin)
    command = event.get("tool_input", {}).get("command")
    if not isinstance(command, str):
        command = json.dumps(command)
    if running(event.get("tool_response")):
        return  # not finished when its call returns: no line, no record (#time-line)
    store = records()
    hook = event.get("hook_event_name")
    if hook == "PreToolUse":
        (store / f"{name(event.get('tool_use_id', ''))}.start").write_text(str(time.time()))
        return
    line = post(event, command, store)
    try:
        warning = disk(store)
    except Exception:
        warning = None  # inform only: a failed check adds nothing (disk.spec.html#warning-inform)
    line = " ".join(filter(None, (line, warning)))
    if line:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": hook, "additionalContext": line}}))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass  # inform only: a failed hook adds nothing (#inform-only)
    sys.exit(0)
