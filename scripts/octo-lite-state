#!/usr/bin/env bash
# Print octo-lite's state directory for the caller's Herdr session: the one
# holding that session's lanes/ and operator files. The session key is
# ${HERDR_SESSION:-default}, as Herdr exports it to every pane of a named
# session and to none of the default one. The default session's directory is
# octo-lite's top one, beside the box's onboarding file; a named session's is
# sessions/<key> under it, as Herdr keeps its own.
# --scratch prints the session's scratch root instead, which holds each of its
# agents' scratch folders by agent name (disk.spec.html#scratch-folder):
# /tmp/octo-lite-<uid>/<key>, short since programs put unix sockets there.
# OCTO_LITE_SCRATCH stands in for /tmp/octo-lite-<uid>, for tests.
set -euo pipefail
key="${HERDR_SESSION:-default}"
if [[ "${1:-}" == --scratch ]]; then
  printf '%s\n' "${OCTO_LITE_SCRATCH:-/tmp/octo-lite-$(id -u)}/$key"
  exit
fi
dir="${XDG_STATE_HOME:-$HOME/.local/state}/octo-lite"
[[ "$key" == default ]] || dir+="/sessions/$key"
printf '%s\n' "$dir"
